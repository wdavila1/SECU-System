<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    :root {
      --primary-color: #1e3a5f;
      --secondary-color: #2c5282;
      --accent-color: #4299e1;
    }
    
    body {
      background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }
    
    .change-password-container {
      background: white;
      border-radius: 16px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
      overflow: hidden;
      max-width: 450px;
      width: 100%;
      margin: 20px;
    }
    
    .header {
      background: var(--primary-color);
      color: white;
      padding: 30px;
      text-align: center;
    }
    
    .header h2 {
      font-weight: 600;
      margin-bottom: 10px;
    }
    
    .header p {
      opacity: 0.9;
      margin: 0;
      font-size: 0.9rem;
    }
    
    .body-content {
      padding: 30px;
    }
    
    .form-label {
      font-weight: 500;
      color: #334155;
    }
    
    .form-control {
      border: 2px solid #e2e8f0;
      border-radius: 10px;
      padding: 12px 15px;
      transition: border-color 0.3s, box-shadow 0.3s;
    }
    
    .form-control:focus {
      border-color: var(--accent-color);
      box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.2);
    }
    
    .btn-primary {
      background: var(--primary-color);
      border: none;
      border-radius: 10px;
      padding: 12px 30px;
      font-weight: 600;
      transition: all 0.3s;
    }
    
    .btn-primary:hover {
      background: var(--secondary-color);
      transform: translateY(-2px);
    }
    
    .alert {
      border-radius: 10px;
      border: none;
    }
    
    .alert-warning {
      background: #fef3c7;
      color: #92400e;
    }
    
    .password-requirements {
      background: #f8fafc;
      border-radius: 10px;
      padding: 15px;
      margin-bottom: 20px;
    }
    
    .password-requirements h6 {
      color: #334155;
      font-weight: 600;
      margin-bottom: 10px;
    }
    
    .password-requirements ul {
      margin: 0;
      padding-left: 20px;
      color: #64748b;
      font-size: 0.9rem;
    }
  </style>
</head>
<body>
  <div class="change-password-container">
    <div class="header">
      <i class="bi bi-key-fill" style="font-size: 3rem;"></i>
      <h2>Cambiar Contraseña</h2>
      <% if (forzado) { %>
        <p>Debe cambiar su contraseña para continuar</p>
      <% } else { %>
        <p>Actualice su contraseña de forma segura</p>
      <% } %>
    </div>
    
    <div class="body-content">
      <% if (forzado) { %>
        <div class="alert alert-warning d-flex align-items-center mb-4">
          <i class="bi bi-exclamation-triangle-fill me-2"></i>
          Su contraseña es temporal. Debe cambiarla para continuar usando el sistema.
        </div>
      <% } %>
      
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger d-flex align-items-center">
          <i class="bi bi-exclamation-triangle-fill me-2"></i>
          <%= error %>
        </div>
      <% } %>
      
      <div class="password-requirements">
        <h6><i class="bi bi-shield-lock me-2"></i>Requisitos de la contraseña:</h6>
        <ul id="listaRequisitos">
          <li id="req-length">Mínimo 8 caracteres</li>
          <li id="req-upper">Al menos 1 letra mayúscula</li>
          <li id="req-lower">Al menos 1 letra minúscula</li>
          <li id="req-number">Al menos 1 número</li>
          <li id="req-special">Al menos 1 carácter especial (!@#$%...)</li>
        </ul>
      </div>
      
      <form action="/cambiar-contrasenia" method="POST">
        <div class="mb-3">
          <label for="contrasenia_actual" class="form-label">
            <i class="bi bi-lock me-1"></i>Contraseña Actual
          </label>
          <input type="password" class="form-control" name="contrasenia_actual" id="contrasenia_actual" required>
        </div>
        
        <div class="mb-3">
          <label for="nueva_contrasenia" class="form-label">
            <i class="bi bi-lock-fill me-1"></i>Nueva Contraseña
          </label>
          <input type="password" class="form-control" name="nueva_contrasenia" id="nueva_contrasenia" minlength="8" required>
        </div>
        
        <div class="mb-4">
          <label for="confirmar_contrasenia" class="form-label">
            <i class="bi bi-check-circle me-1"></i>Confirmar Nueva Contraseña
          </label>
          <input type="password" class="form-control" name="confirmar_contrasenia" id="confirmar_contrasenia" minlength="8" required>
        </div>
        
        <div class="d-grid gap-2">
          <button type="submit" class="btn btn-primary">
            <i class="bi bi-check-lg me-2"></i>Cambiar Contraseña
          </button>
          <% if (!forzado) { %>
            <a href="/" class="btn btn-outline-secondary">
              <i class="bi bi-arrow-left me-2"></i>Volver
            </a>
          <% } %>
        </div>
      </form>
    </div>
  </div>
  
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    const input = document.getElementById('nueva_contrasenia');

    function checkReq(id, test) {
      const el = document.getElementById(id);
      if (test) {
        el.style.color = '#16a34a';
        el.innerHTML = '✓ ' + el.innerHTML.replace(/^[✓✗] /, '');
      } else {
        el.style.color = '#dc2626';
        el.innerHTML = '✗ ' + el.innerHTML.replace(/^[✓✗] /, '');
      }
    }

    input.addEventListener('input', function() {
      const v = this.value;
      checkReq('req-length',  v.length >= 8);
      checkReq('req-upper',   /[A-Z]/.test(v));
      checkReq('req-lower',   /[a-z]/.test(v));
      checkReq('req-number',  /[0-9]/.test(v));
      checkReq('req-special', /[!@#$%^&*()\-_=+\[\]{}|;:,.<>?]/.test(v));
    });

    document.querySelector('form').addEventListener('submit', function(e) {
      const nueva = document.getElementById('nueva_contrasenia').value;
      const confirmar = document.getElementById('confirmar_contrasenia').value;
      if (nueva !== confirmar) {
        e.preventDefault();
        alert('Las contraseñas nuevas no coinciden');
        return;
      }
      if (nueva.length < 8 || !/[A-Z]/.test(nueva) || !/[a-z]/.test(nueva) ||
          !/[0-9]/.test(nueva) || !/[!@#$%^&*()\-_=+\[\]{}|;:,.<>?]/.test(nueva)) {
        e.preventDefault();
        alert('La contraseña no cumple con todos los requisitos de seguridad');
      }
    });
  </script>
</body>
</html>
