<%- include('../../partials/digitador-header', { active: 'reportes' }, { title: 'Reporte de Facturas - SECU' }) %>
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>

<% const active = 'reportes'; %>

<div class="mb-4">
    <a href="/digitador/reportes" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>Volver a Reportes
    </a>
</div>

<div class="page-title">Reporte de Facturas</div>
<p class="page-subtitle">Control de facturacion por periodo y estado de pago</p>

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-header">
        <i class="bi bi-funnel me-2"></i>Filtros
    </div>
    <div class="card-body">
        <form method="GET" action="/digitador/reportes/facturas">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Fecha Inicio</label>
                    <input type="date" name="fecha_inicio" class="form-control" 
                           value="<%= filtros.fecha_inicio || '' %>">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fecha Fin</label>
                    <input type="date" name="fecha_fin" class="form-control" 
                           value="<%= filtros.fecha_fin || '' %>">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Estado</label>
                    <select name="estado" class="form-select">
                        <option value="">Todos</option>
                        <option value="Pendiente" <%= filtros.estado === 'Pendiente' ? 'selected' : '' %>>Pendiente</option>
                        <option value="Pagada" <%= filtros.estado === 'Pagada' ? 'selected' : '' %>>Pagada</option>
                        <option value="Negada" <%= filtros.estado === 'Negada' ? 'selected' : '' %>>Negada</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Empresa</label>
                    <select name="empresa" id="filtroEmpresaFacturas" class="form-select">
                        <option value="">Todas</option>
                        <% empresas.forEach(e => { %>
                            <option value="<%= e.id_empresa %>" <%= filtros.empresa == e.id_empresa ? 'selected' : '' %>><%= e.empresa %></option>
                        <% }); %>
                    </select>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search me-2"></i>Filtrar
                </button>
                <a href="/digitador/reportes/facturas" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-2"></i>Limpiar
                </a>
                <button type="button" class="btn btn-outline-success" onclick="window.print()">
                    <i class="bi bi-printer me-2"></i>Imprimir
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Stat Cards Resumen -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="d-flex align-items-center">
                <div class="icon me-3" style="background: #0e7490;">
                    <i class="bi bi-receipt"></i>
                </div>
                <div>
                    <div class="value"><%= totales.total_facturas %></div>
                    <div class="label">Total Facturas</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="d-flex align-items-center">
                <div class="icon me-3" style="background: #10b981;">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <div class="value">L. <%= parseFloat(totales.monto_pagado || 0).toLocaleString('es-HN', {minimumFractionDigits: 2}) %></div>
                    <div class="label">Monto Pagado</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="d-flex align-items-center">
                <div class="icon me-3" style="background: #f59e0b;">
                    <i class="bi bi-clock"></i>
                </div>
                <div>
                    <div class="value">L. <%= parseFloat(totales.monto_pendiente || 0).toLocaleString('es-HN', {minimumFractionDigits: 2}) %></div>
                    <div class="label">Monto Pendiente</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Graficas Chart.js -->
<div class="row g-4 mb-4">
    <!-- Grafica Donut: Por Estado -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-pie-chart me-2"></i>Facturas por Estado
            </div>
            <div class="card-body">
                <canvas id="graficaEstado" height="220"></canvas>
            </div>
        </div>
    </div>
    
    <!-- Grafica Barras: Monto por Empresa -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-bar-chart me-2"></i>Monto Facturado por Empresa
            </div>
            <div class="card-body">
                <canvas id="graficaEmpresa" height="220"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de Resultados -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-table me-2"></i>Facturas</span>
        <span class="badge bg-primary"><%= facturas.length %> registros</span>
    </div>
    <div class="card-body p-0">
        <% if (facturas.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Numero</th>
                            <th>Empresa</th>
                            <th>Fecha</th>
                            <th>Monto</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% facturas.forEach(function(f) { 
                            let badgeClass = 'bg-secondary';
                            if (f.status_factura === 'Pendiente') badgeClass = 'bg-warning text-dark';
                            if (f.status_factura === 'Pagada') badgeClass = 'bg-success';
                            if (f.status_factura === 'Negada') badgeClass = 'bg-danger';
                        %>
                            <tr>
                                <td><strong><%= f.numero_factura %></strong></td>
                                <td><%= f.empresa %></td>
                                <td>
                                    <% if (f.fecha_factura) { %>
                                        <%= new Date(f.fecha_factura).toLocaleDateString('es-HN') %>
                                    <% } else { %>
                                        <span class="text-muted">Sin fecha</span>
                                    <% } %>
                                </td>
                                <td><strong>L. <%= parseFloat(f.monto_total || 0).toLocaleString('es-HN', {minimumFractionDigits: 2}) %></strong></td>
                                <td><span class="badge <%= badgeClass %>"><%= f.status_factura %></span></td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted"></i>
                <p class="text-muted mt-3">No se encontraron facturas con los filtros aplicados</p>
            </div>
        <% } %>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
const coloresTeal   = ['#0e7490','#0891b2','#06b6d4','#67e8f9','#22d3ee','#14b8a6','#2dd4bf','#5eead4','#99f6e4','#ccfbf1'];
const coloresEstado = { 'Pendiente': '#f59e0b', 'Pagada': '#10b981', 'Negada': '#ef4444' };

const porEstadoData  = <%- JSON.stringify(porEstado) %>;
const porEmpresaData = <%- JSON.stringify(porEmpresa) %>;

function sinDatos(canvasId) {
  const el = document.getElementById(canvasId);
  if (!el) return;
  el.parentElement.innerHTML = '<div class="d-flex flex-column justify-content-center align-items-center h-100 text-muted py-4"><i class="bi bi-bar-chart fs-1 opacity-25"></i><small class="mt-2">Sin datos para mostrar</small></div>';
}

document.addEventListener('DOMContentLoaded', function() {
  // TomSelect empresa
  new TomSelect('#filtroEmpresaFacturas', { placeholder: 'Buscar empresa...', allowEmptyOption: true });

  // Donut: Por Estado
  if (porEstadoData.length > 0) {
    new Chart(document.getElementById('graficaEstado'), {
      type: 'doughnut',
      data: {
        labels: porEstadoData.map(r => r.estado),
        datasets: [{ data: porEstadoData.map(r => r.total), backgroundColor: porEstadoData.map(r => coloresEstado[r.estado] || '#6b7280'), borderWidth: 0 }]
      },
      options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { position: 'bottom' } } }
    });
  } else { sinDatos('graficaEstado'); }

  // Barras horizontales: Monto por Empresa
  if (porEmpresaData.length > 0) {
    new Chart(document.getElementById('graficaEmpresa'), {
      type: 'bar',
      data: {
        labels: porEmpresaData.map(r => r.empresa.length > 16 ? r.empresa.substring(0,16) + '…' : r.empresa),
        datasets: [{ label: 'Monto (L.)', data: porEmpresaData.map(r => r.total), backgroundColor: coloresTeal.slice(0, porEmpresaData.length), borderRadius: 4 }]
      },
      options: { indexAxis: 'y', responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { x: { beginAtZero: true } } }
    });
  } else { sinDatos('graficaEmpresa'); }
});
</script>

<style>
@media print {
  .btn, .sidebar, .top-header, .card-header form { display: none !important; }
  .main-wrapper { margin-left: 0 !important; }
  .card { border: 1px solid #ddd !important; box-shadow: none !important; }
}
</style>

<%- include('../../partials/digitador-footer') %>
