<%- include('../../partials/digitador-header', { active: 'reportes' }, { title: 'Reporte de Servicios - SECU' }) %>

<% const active = 'reportes'; %>

<div class="mb-4">
    <a href="/digitador/reportes" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>Volver a Reportes
    </a>
</div>

<div class="page-title">Reporte de Servicios</div>
<p class="page-subtitle">Consulta y filtra los servicios que has registrado</p>

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-header">
        <i class="bi bi-funnel me-2"></i>Filtros
    </div>
    <div class="card-body">
        <form method="GET" action="/digitador/reportes/servicios">
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Fecha Inicio</label>
                    <input type="date" name="fecha_inicio" class="form-control" 
                           value="<%= filtros.fecha_inicio || '' %>">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Fecha Fin</label>
                    <input type="date" name="fecha_fin" class="form-control" 
                           value="<%= filtros.fecha_fin || '' %>">
                </div>
                <div class="col-md-3">
                    <label class="form-label">Tipo de Servicio</label>
                    <select name="tipo" class="form-select">
                        <option value="">Todos</option>
                        <% tiposServicio.forEach(function(ts) { %>
                            <option value="<%= ts.id_tipo_servicio %>" 
                                    <%= filtros.tipo == ts.id_tipo_servicio ? 'selected' : '' %>>
                                <%= ts.tipo_servicio %>
                            </option>
                        <% }); %>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Estado</label>
                    <select name="estado" class="form-select">
                        <option value="">Todos</option>
                        <option value="Pendiente" <%= filtros.estado === 'Pendiente' ? 'selected' : '' %>>Pendiente</option>
                        <option value="En proceso" <%= filtros.estado === 'En proceso' ? 'selected' : '' %>>En proceso</option>
                        <option value="Finalizado" <%= filtros.estado === 'Finalizado' ? 'selected' : '' %>>Finalizado</option>
                        <option value="Cancelado" <%= filtros.estado === 'Cancelado' ? 'selected' : '' %>>Cancelado</option>
                    </select>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search me-2"></i>Filtrar
                </button>
                <a href="/digitador/reportes/servicios" class="btn btn-outline-secondary">
                    <i class="bi bi-x-circle me-2"></i>Limpiar
                </a>
                <button type="button" class="btn btn-outline-success" onclick="window.print()">
                    <i class="bi bi-printer me-2"></i>Imprimir
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Graficas Chart.js -->
<% if (servicios.length > 0) { %>
<div class="row g-4 mb-4">
    <!-- Grafica de Barras: Servicios por Tipo -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-bar-chart me-2"></i>Servicios por Tipo
            </div>
            <div class="card-body">
                <canvas id="graficaTipo" height="200"></canvas>
            </div>
        </div>
    </div>
    
    <!-- Grafica Donut: Servicios por Estado -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-pie-chart me-2"></i>Servicios por Estado
            </div>
            <div class="card-body">
                <canvas id="graficaEstado" height="200"></canvas>
            </div>
        </div>
    </div>
</div>
<% } %>

<!-- Resumen -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="stat-card">
            <div class="d-flex align-items-center">
                <div class="icon bg-primary me-3">
                    <i class="bi bi-briefcase"></i>
                </div>
                <div>
                    <div class="value"><%= servicios.length %></div>
                    <div class="label">Total Servicios</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="d-flex align-items-center">
                <div class="icon bg-warning me-3">
                    <i class="bi bi-clock"></i>
                </div>
                <div>
                    <div class="value"><%= servicios.filter(s => s.estado_servicio === 'Pendiente').length %></div>
                    <div class="label">Pendientes</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="stat-card">
            <div class="d-flex align-items-center">
                <div class="icon bg-success me-3">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <div class="value"><%= servicios.filter(s => s.estado_servicio === 'Finalizado').length %></div>
                    <div class="label">Finalizados</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tabla de Resultados -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-table me-2"></i>Resultados</span>
        <span class="badge bg-primary"><%= servicios.length %> registros</span>
    </div>
    <div class="card-body p-0">
        <% if (servicios.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Fecha</th>
                            <th>Candidato</th>
                            <th>Tipo de Servicio</th>
                            <th>Empresa</th>
                            <th>Ciudad</th>
                            <th>Estado</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% servicios.forEach(function(servicio) { %>
                            <tr>
                                <td><strong>#<%= servicio.id_servicio %></strong></td>
                                <td><%= new Date(servicio.fecha_servicio).toLocaleDateString('es-HN') %></td>
                                <td><%= servicio.candidato_nombre %></td>
                                <td><%= servicio.tipo_servicio %></td>
                                <td><%= servicio.empresa %></td>
                                <td><%= servicio.ciudad %></td>
                                <td>
                                    <span class="badge 
                                        <% if (servicio.estado_servicio === 'Pendiente') { %>bg-warning text-dark
                                        <% } else if (servicio.estado_servicio === 'En proceso') { %>bg-info
                                        <% } else if (servicio.estado_servicio === 'Finalizado') { %>bg-success
                                        <% } else { %>bg-danger<% } %>">
                                        <%= servicio.estado_servicio %>
                                    </span>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } else { %>
            <div class="text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted"></i>
                <p class="text-muted mt-3">No se encontraron servicios con los filtros aplicados</p>
            </div>
        <% } %>
    </div>
</div>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<% if (servicios.length > 0) { %>
<script>
// Paleta Digitador: teal
const coloresTeal = ['#0e7490', '#0891b2', '#06b6d4', '#67e8f9', '#22d3ee', '#14b8a6'];
const coloresEstado = {
  'Pendiente': '#f59e0b',
  'En proceso': '#0891b2',
  'Finalizado': '#10b981',
  'Cancelado': '#ef4444'
};

// Grafica de Barras: Por Tipo
new Chart(document.getElementById('graficaTipo'), {
  type: 'bar',
  data: {
    labels: [<%- porTipo.map(r => `'${r.tipo_servicio}'`).join(',') %>],
    datasets: [{
      label: 'Cantidad',
      data: [<%= porTipo.map(r => r.total).join(',') %>],
      backgroundColor: coloresTeal.slice(0, <%= porTipo.length %>),
      borderRadius: 4
    }]
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: { display: false }
    },
    scales: {
      y: { beginAtZero: true, ticks: { stepSize: 1 } }
    }
  }
});

// Grafica Donut: Por Estado
new Chart(document.getElementById('graficaEstado'), {
  type: 'doughnut',
  data: {
    labels: [<%- porEstado.map(r => `'${r.estado_servicio}'`).join(',') %>],
    datasets: [{
      data: [<%= porEstado.map(r => r.total).join(',') %>],
      backgroundColor: [<%- porEstado.map(r => `coloresEstado['${r.estado_servicio}'] || '#6b7280'`).join(',') %>],
      borderWidth: 0
    }]
  },
  options: {
    responsive: true,
    maintainAspectRatio: false,
    plugins: {
      legend: { position: 'right' }
    }
  }
});
</script>
<% } %>

<style>
@media print {
    .btn, .sidebar, .top-header, .card-header form {
        display: none !important;
    }
    .main-wrapper {
        margin-left: 0 !important;
    }
    .card {
        border: 1px solid #ddd !important;
        box-shadow: none !important;
    }
}
</style>

<%- include('../../partials/digitador-footer') %>
