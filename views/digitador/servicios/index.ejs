<%- include('../../partials/digitador-header', { active: 'servicios' }) %>

<!-- Tom Select CDN -->
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>

<div class="mb-4">
  <h1 class="page-title">Gestión de Servicios</h1>
  <p class="page-subtitle mb-0">Administra los servicios del sistema</p>
</div>

<!-- Filtros -->
<div class="card mb-4">
  <div class="card-body">
    <form action="/digitador/servicios" method="GET" class="row g-3 align-items-end">
      
      <div class="col">
        <label class="form-label text-muted small fw-bold">Buscar</label>
        <input type="text" class="form-control" name="buscar" placeholder="Buscar candidato..." value="<%= filtros.buscar || '' %>">
      </div>

      <div class="col-md-2">
        <label class="form-label text-muted small fw-bold">Estado</label>
        <select class="form-select" name="estado">
          <option value="">Todos</option>
          <option value="Pendiente" <%= filtros.estado === 'Pendiente' ? 'selected' : '' %>>Pendiente</option>
          <option value="En proceso" <%= filtros.estado === 'En proceso' ? 'selected' : '' %>>En proceso</option>
          <option value="Finalizado" <%= filtros.estado === 'Finalizado' ? 'selected' : '' %>>Finalizado</option>
          <option value="Cancelado" <%= filtros.estado === 'Cancelado' ? 'selected' : '' %>>Cancelado</option>
        </select>
      </div>

      <div class="col-md-2">
        <label class="form-label text-muted small fw-bold">Tipo</label>
        <select class="form-select" name="tipo">
          <option value="">Todos</option>
          <% tiposServicio.forEach(tipo => { %>
            <option value="<%= tipo.id_tipo_servicio %>" <%= filtros.tipo == tipo.id_tipo_servicio ? 'selected' : '' %>><%= tipo.tipo_servicio %></option>
          <% }); %>
        </select>
      </div>

      <div class="col-md-2">
        <label class="form-label text-muted small fw-bold">Empresa</label>
        <select class="form-select" name="empresa" id="filtroEmpresaServicios">
          <option value="">Todas las empresas</option>
          <% empresas.forEach(emp => { %>
            <option value="<%= emp.id_empresa %>" <%= filtros.empresa == emp.id_empresa ? 'selected' : '' %>><%= emp.empresa %></option>
          <% }); %>
        </select>
      </div>

      <div class="col-auto d-flex gap-2">
        
        <button type="submit" class="btn btn-primary d-flex align-items-center justify-content-center" 
                style="min-width: 160px; height: 38px;">
          <i class="bi bi-search me-2"></i> Filtrar
        </button>

        <a href="/digitador/servicios" 
           class="btn btn-outline-secondary d-flex align-items-center justify-content-center" 
           style="width: 38px; height: 38px; min-width: 38px; padding: 0;" 
           title="Limpiar filtros">
          <i class="bi bi-x-lg"></i>
        </a>
      </div>

    </form>
  </div>
</div>

<!-- Tabla de Servicios -->
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th style="width: 6%">ID</th>
            <th style="width: 16%">Candidato</th>
            <th style="width: 14%">Tipo</th>
            <th style="width: 16%">Empresa</th>
            <th style="width: 14%">Encuestador</th>
            <th style="width: 10%">Fecha</th>
            <th style="width: 10%">Estado</th>
            <th style="width: 14%" class="text-center">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (servicios.length > 0) { %>
            <% servicios.forEach(s => { 
              let badgeClass = 'bg-secondary';
              if (s.estado_servicio === 'Pendiente') badgeClass = 'bg-warning text-dark';
              if (s.estado_servicio === 'En proceso') badgeClass = 'bg-info';
              if (s.estado_servicio === 'Finalizado') badgeClass = 'bg-success';
              if (s.estado_servicio === 'Cancelado') badgeClass = 'bg-danger';
            %>
              <tr>
                <td><strong>#<%= s.id_servicio %></strong></td>
                <td><%= s.candidato_nombre %></td>
                <td><span class="badge bg-primary-subtle text-primary"><%= s.tipo_servicio %></span></td>
                <td><%= s.empresa %></td>
                <td>
                  <% if (s.encuestador_nombre !== 'Sin asignar') { %>
                    <span class="text-success"><i class="bi bi-person-check me-1"></i><%= s.encuestador_nombre %></span>
                  <% } else { %>
                    <span class="text-muted"><i class="bi bi-person-x me-1"></i>Sin asignar</span>
                  <% } %>
                </td>
                <td><%= new Date(s.fecha_servicio).toLocaleDateString('es-HN') %></td>
                <td><span class="badge <%= badgeClass %>"><%= s.estado_servicio %></span></td>
                <td class="text-center">
                  <a href="/digitador/servicios/editar/<%= s.id_servicio %>" class="btn btn-sm btn-primary me-1" title="Editar" data-bs-toggle="tooltip" data-bs-placement="top">
                    <i class="bi bi-pencil"></i>
                  </a>
                  <a href="/digitador/servicios/<%= s.id_servicio %>/formularios" class="btn btn-sm btn-outline-secondary me-1" title="Formularios" data-bs-toggle="tooltip" data-bs-placement="top">
                    <i class="bi bi-file-text"></i>
                  </a>
                  <% if (s.estado_servicio === 'Pendiente' && !s.formulario_bloqueado && s.id_expediente) { %>
                    <button type="button" class="btn btn-sm btn-outline-danger"
                      title="Eliminar servicio" data-bs-toggle="tooltip" data-bs-placement="top"
                      onclick="confirmarAccion(
                        'Eliminar Servicio',
                        'Se eliminará el servicio #<%= s.id_servicio %>. Esta acción no se puede deshacer.',
                        '/digitador/expedientes/<%= s.id_expediente %>/servicio/<%= s.id_servicio %>/eliminar?redirect=/digitador/servicios'
                      )">
                      <i class="bi bi-trash"></i>
                    </button>
                  <% } else { %>
                    <button type="button" class="btn btn-sm btn-outline-danger" disabled
                      title="<%= s.estado_servicio !== 'Pendiente' ? 'Solo se pueden eliminar servicios Pendientes' : s.formulario_bloqueado ? 'Formulario iniciado, no se puede eliminar' : 'No pertenece a un expediente' %>"
                      data-bs-toggle="tooltip" data-bs-placement="top">
                      <i class="bi bi-trash"></i>
                    </button>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center py-5">
                <i class="bi bi-briefcase" style="font-size: 3rem; color: #94a3b8;"></i>
                <p class="text-muted mt-2">No se encontraron servicios</p>
                <a href="/digitador/servicios/nuevo" class="btn btn-primary">Crear primer servicio</a>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(el => {
    new bootstrap.Tooltip(el);
  });
  
  // Tom Select para filtro de empresa
  new TomSelect('#filtroEmpresaServicios', {
    placeholder: 'Buscar empresa...',
    allowEmptyOption: true
  });
});
</script>

<%- include('../../partials/digitador-footer') %>
