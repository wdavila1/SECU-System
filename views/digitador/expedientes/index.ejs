<%- include('../../partials/digitador-header', { active: 'expedientes' }) %>

<!-- Tom Select CDN -->
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="page-title">Expedientes</h1>
    <p class="page-subtitle mb-0">Gestiona los expedientes de candidatos</p>
  </div>
  <a href="/digitador/expedientes/nuevo" class="btn btn-primary">
    <i class="bi bi-plus-lg me-2"></i>Nuevo Expediente
  </a>
</div>

<!-- Filtros -->
<div class="card mb-4">
  <div class="card-body">
    <form method="GET" class="row g-3 align-items-end">
      
      <div class="col">
        <label class="form-label text-muted small fw-bold">Buscar</label>
        <input type="text" name="buscar" value="<%= filtros.buscar || '' %>" placeholder="Buscar candidato o DNI..." class="form-control">
      </div>

      <div class="col-md-2">
        <label class="form-label text-muted small fw-bold">Estado</label>
        <select name="estado" class="form-select">
          <option value="">Todos</option>
          <option value="En proceso" <%= filtros.estado === 'En proceso' ? 'selected' : '' %>>En proceso</option>
          <option value="Finalizado" <%= filtros.estado === 'Finalizado' ? 'selected' : '' %>>Finalizado</option>
          <option value="Cancelado" <%= filtros.estado === 'Cancelado' ? 'selected' : '' %>>Cancelado</option>
        </select>
      </div>

      <div class="col-md-3">
        <label class="form-label text-muted small fw-bold">Empresa</label>
        <select name="empresa" id="filtroEmpresa" class="form-select">
          <option value="">Todas las empresas</option>
          <% empresas.forEach(emp => { %>
            <option value="<%= emp.id_empresa %>" <%= filtros.empresa == emp.id_empresa ? 'selected' : '' %>><%= emp.empresa %></option>
          <% }); %>
        </select>
      </div>

      <div class="col-auto d-flex gap-2">
        <button type="submit" class="btn btn-primary d-flex align-items-center justify-content-center" 
                style="min-width: 160px; height: 38px;">
          <i class="bi bi-search me-2"></i> Filtrar
        </button>

        <a href="/digitador/expedientes" 
           class="btn btn-outline-secondary d-flex align-items-center justify-content-center" 
           style="width: 38px; height: 38px; min-width: 38px; padding: 0;" 
           title="Limpiar filtros">
          <i class="bi bi-x-lg"></i>
        </a>
      </div>

    </form>
  </div>
</div>

<!-- Tabla de Expedientes -->
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0">
        <thead>
          <tr>
            <th style="width: 6%">#ID</th>
            <th style="width: 20%">Candidato</th>
            <th style="width: 12%">DNI</th>
            <th style="width: 20%">Empresa</th>
            <th style="width: 12%">Fecha</th>
            <th style="width: 10%">Estado</th>
            <th style="width: 8%"># Servicios</th>
            <th style="width: 12%" class="text-center">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (expedientes.length > 0) { %>
            <% expedientes.forEach(exp => { %>
              <tr>
                <td><strong><%= exp.id_expediente %></strong></td>
                <td><%= exp.candidato_nombre %></td>
                <td><%= exp.dni %></td>
                <td><%= exp.empresa %></td>
                <td><%= new Date(exp.fecha_expediente).toLocaleDateString('es-HN') %></td>
                <td>
                  <% 
                    let badgeClass = 'bg-warning text-dark';
                    if (exp.estado === 'Finalizado') badgeClass = 'bg-success';
                    if (exp.estado === 'Cancelado') badgeClass = 'bg-danger';
                  %>
                  <span class="badge <%= badgeClass %>"><%= exp.estado %></span>
                </td>
                <td>
                  <span class="badge bg-info"><%= exp.num_servicios %></span>
                </td>
                <td class="text-center">
                  <a href="/digitador/expedientes/<%= exp.id_expediente %>" class="btn btn-sm btn-primary">
                    <i class="bi bi-folder2-open me-1"></i>Abrir
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center py-5">
                <i class="bi bi-folder2-open" style="font-size: 3rem; color: #94a3b8;"></i>
                <p class="text-muted mt-2">No hay expedientes registrados</p>
                <a href="/digitador/expedientes/nuevo" class="btn btn-primary">Crear primer expediente</a>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
<% if (totalPages > 1) { %>
<nav class="mt-3 px-3 pb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
  <small class="text-muted">Mostrando <%= (page-1)*10+1 %>–<%= Math.min(page*10, total) %> de <%= total %> registros</small>
  <ul class="pagination pagination-sm mb-0">
    <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
      <a class="page-link" href="?<%= new URLSearchParams({...filtros, page: page-1}).toString() %>"><i class="bi bi-chevron-left"></i></a>
    </li>
    <% for(let i = 1; i <= totalPages; i++) { %>
      <% if (i === 1 || i === totalPages || (i >= page-2 && i <= page+2)) { %>
        <li class="page-item <%= i === page ? 'active' : '' %>">
          <a class="page-link" href="?<%= new URLSearchParams({...filtros, page: i}).toString() %>"><%= i %></a>
        </li>
      <% } else if (i === page-3 || i === page+3) { %>
        <li class="page-item disabled"><span class="page-link">…</span></li>
      <% } %>
    <% } %>
    <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
      <a class="page-link" href="?<%= new URLSearchParams({...filtros, page: page+1}).toString() %>"><i class="bi bi-chevron-right"></i></a>
    </li>
  </ul>
</nav>
<% } %>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  new TomSelect('#filtroEmpresa', {
    placeholder: 'Buscar empresa...',
    allowEmptyOption: true
  });
});
</script>

<%- include('../../partials/digitador-footer') %>
