<%- include('../partials/encuestador-header') %>

<% const active = 'dashboard'; %>

<div class="page-title">Panel de Encuestador</div>
<p class="page-subtitle">Bienvenido, <%= user.nombre_completo %></p>

<!-- Stats Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-4">
        <div class="stat-card" style="border-left: 4px solid #059669;">
            <div class="d-flex align-items-center">
                <div class="icon me-3" style="background: #059669;">
                    <i class="bi bi-briefcase"></i>
                </div>
                <div>
                    <div class="value"><%= serviciosAsignados %></div>
                    <div class="label">Servicios Asignados</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-4">
        <div class="stat-card" style="border-left: 4px solid #f59e0b;">
            <div class="d-flex align-items-center">
                <div class="icon me-3" style="background: #f59e0b;">
                    <i class="bi bi-clock-history"></i>
                </div>
                <div>
                    <div class="value"><%= serviciosPendientes %></div>
                    <div class="label">Pendientes</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-lg-4">
        <div class="stat-card" style="border-left: 4px solid #10b981;">
            <div class="d-flex align-items-center">
                <div class="icon me-3" style="background: #10b981;">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div>
                    <div class="value"><%= serviciosFinalizados %></div>
                    <div class="label">Finalizados</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Servicios Pendientes -->
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <i class="bi bi-list-task me-2"></i>Servicios Pendientes
        </div>
        <a href="/encuestador/servicios" class="btn btn-sm btn-outline-primary">Ver Todos</a>
    </div>
    <div class="card-body p-0">
        <% if (serviciosPendientesLista.length > 0) { %>
            <div class="list-group list-group-flush">
                <% serviciosPendientesLista.forEach(function(servicio) { %>
                    <a href="/encuestador/servicios/<%= servicio.id_servicio %>" class="list-group-item list-group-item-action">
                        <div class="d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center gap-3">
                                <div class="rounded-circle d-flex align-items-center justify-content-center" 
                                     style="width: 45px; height: 45px; background: rgba(5, 150, 105, 0.1); color: #059669; font-weight: bold;">
                                    <%= servicio.candidato_nombre.charAt(0) %>
                                </div>
                                <div>
                                    <h6 class="mb-0"><%= servicio.candidato_nombre %></h6>
                                    <small class="text-muted">
                                        <%= servicio.tipo_servicio %> - <%= servicio.empresa %>
                                    </small>
                                </div>
                            </div>
                            <div class="text-end">
                                <span class="badge 
                                    <% if (servicio.estado_servicio === 'Pendiente') { %>bg-warning text-dark
                                    <% } else { %>bg-info<% } %>">
                                    <%= servicio.estado_servicio %>
                                </span>
                                <div class="small text-muted mt-1">
                                    <i class="bi bi-geo-alt me-1"></i><%= servicio.ciudad %>
                                </div>
                            </div>
                        </div>
                    </a>
                <% }); %>
            </div>
        <% } else { %>
            <div class="text-center py-5">
                <i class="bi bi-check-circle text-success" style="font-size: 3rem;"></i>
                <h5 class="mt-3 text-muted">Todo al dia</h5>
                <p class="text-muted">No tienes servicios pendientes en este momento</p>
            </div>
        <% } %>
    </div>
</div>

<%- include('../partials/encuestador-footer') %>
