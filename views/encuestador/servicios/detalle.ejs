<%- include('../../partials/encuestador-header') %>

<% const active = 'servicios'; %>

<div class="mb-4">
    <a href="/encuestador/servicios" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Volver a Servicios
    </a>
</div>

<%
const _hoyDet = new Date(); _hoyDet.setHours(0,0,0,0);
const _limiteDet = servicio.fecha_limite ? new Date(servicio.fecha_limite) : null;
if (_limiteDet) _limiteDet.setHours(0,0,0,0);
const _vencidoDet = _limiteDet && _limiteDet < _hoyDet && servicio.estado_servicio !== 'Finalizado' && servicio.estado_servicio !== 'Cancelado';
const _diasDet = _limiteDet ? Math.ceil((_limiteDet - _hoyDet) / 86400000) : null;
%>
<% if (_vencidoDet) { %>
<div class="alert alert-danger d-flex align-items-center gap-2 mb-4">
    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
    <div>
        <strong>Servicio con plazo vencido</strong> — Este servicio debía completarse el
        <%= new Date(servicio.fecha_limite).toLocaleDateString('es-HN') %>
        (hace <%= Math.abs(_diasDet) %> día(s)). Por favor contacta a tu supervisor.
    </div>
</div>
<% } %>

<!-- Informacion del Candidato -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-auto">
                <div class="rounded-circle d-flex align-items-center justify-content-center" 
                     style="width: 80px; height: 80px; background: rgba(5, 150, 105, 0.1); color: #059669; font-weight: bold; font-size: 1.8rem;">
                    <%= servicio.p_nombre.charAt(0) %><%= servicio.p_apellido.charAt(0) %>
                </div>
            </div>
            <div class="col">
                <h3 class="mb-1"><%= servicio.p_nombre %> <%= servicio.s_nombre %> <%= servicio.p_apellido %> <%= servicio.s_apellido %></h3>
                <p class="text-muted mb-2">
                    <i class="bi bi-card-text me-1"></i>DNI: <%= servicio.dni %>
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <span class="badge bg-primary-subtle text-primary">
                        <i class="bi bi-briefcase me-1"></i><%= servicio.tipo_servicio %>
                    </span>
                    <span class="badge bg-secondary-subtle text-secondary">
                        <i class="bi bi-building me-1"></i><%= servicio.empresa %>
                    </span>
                    <span class="badge bg-info-subtle text-info">
                        <i class="bi bi-geo-alt me-1"></i><%= servicio.ciudad %>, <%= servicio.departamento %>
                    </span>
                </div>
            </div>
            <div class="col-auto text-end">
                <% if (servicio.fecha_limite && servicio.estado_servicio !== 'Finalizado' && servicio.estado_servicio !== 'Cancelado') {
                    const hoy = new Date();
                    hoy.setHours(0, 0, 0, 0);
                    const limite = new Date(servicio.fecha_limite);
                    limite.setHours(0, 0, 0, 0);
                    const diasRestantes = Math.ceil((limite - hoy) / 86400000);
                %>
                    <% if (diasRestantes < 0) { %>
                        <span class="badge fs-6 bg-danger mb-1"><i class="bi bi-exclamation-triangle me-1"></i>Vencido</span>
                    <% } else if (diasRestantes <= 2) { %>
                        <span class="badge fs-6 bg-warning text-dark mb-1"><i class="bi bi-clock me-1"></i><%= diasRestantes %> dias restantes</span>
                    <% } else { %>
                        <span class="badge fs-6 bg-secondary mb-1"><i class="bi bi-calendar me-1"></i><%= diasRestantes %> dias restantes</span>
                    <% } %>
                    <br>
                <% } %>
                <span class="badge fs-6
                    <% if (servicio.estado_servicio === 'Pendiente') { %>bg-warning text-dark
                    <% } else if (servicio.estado_servicio === 'En proceso') { %>bg-info
                    <% } else if (servicio.estado_servicio === 'Finalizado') { %>bg-success
                    <% } else { %>bg-danger<% } %>">
                    <%= servicio.estado_servicio %>
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Informacion de Contacto -->
<div class="card mb-4">
    <div class="card-header bg-light">
        <i class="bi bi-person-lines-fill me-2"></i>Informacion del Candidato
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <small class="text-muted">Correo Electronico</small>
                <p class="mb-0"><i class="bi bi-envelope me-1"></i><%= servicio.correo %></p>
            </div>
            <div class="col-md-4">
                <small class="text-muted">Telefono</small>
                <p class="mb-0"><i class="bi bi-telephone me-1"></i><%= servicio.telefono %></p>
            </div>
            <div class="col-md-4">
                <small class="text-muted">Direccion</small>
                <p class="mb-0"><i class="bi bi-house me-1"></i><%= servicio.direccion %></p>
            </div>
            <div class="col-md-4">
                <small class="text-muted">Fecha de Nacimiento</small>
                <p class="mb-0"><i class="bi bi-calendar me-1"></i><%= new Date(servicio.fecha_nacimiento).toLocaleDateString('es-HN') %></p>
            </div>
            <div class="col-md-4">
                <small class="text-muted">Genero</small>
                <p class="mb-0"><i class="bi bi-gender-ambiguous me-1"></i><%= servicio.genero || 'No especificado' %></p>
            </div>
            <div class="col-md-4">
                <small class="text-muted">Fecha del Servicio</small>
                <p class="mb-0"><i class="bi bi-calendar-check me-1"></i><%= new Date(servicio.fecha_servicio).toLocaleDateString('es-HN') %></p>
            </div>
            <% if (servicio.fecha_limite) { %>
            <div class="col-md-4">
                <small class="text-muted">Fecha Límite</small>
                <p class="mb-0 <%= _vencidoDet ? 'text-danger fw-bold' : (_diasDet !== null && _diasDet <= 2 ? 'text-warning fw-bold' : '') %>">
                    <i class="bi bi-calendar-x me-1"></i><%= new Date(servicio.fecha_limite).toLocaleDateString('es-HN') %>
                    <% if (_vencidoDet) { %><span class="badge bg-danger ms-1">Vencido</span><% } %>
                </p>
            </div>
            <% } %>
        </div>
    </div>
</div>

<!-- Formularios Disponibles -->
<div class="card mb-4">
    <div class="card-header bg-light">
        <i class="bi bi-file-earmark-text me-2"></i>Formularios a Completar
    </div>
    <div class="card-body">
        <div class="row g-4">
            <% 
            // Determinar que formularios mostrar segun el tipo de servicio
            const tipoServicio = servicio.tipo_servicio.toLowerCase();
            const mostrarSocioeconomico = tipoServicio.includes('socioeconomico') || tipoServicio.includes('socioeconómico');
            const mostrarPoligrafia = tipoServicio.includes('poligraf');
            const mostrarPsicometrico = tipoServicio.includes('psicomet') || tipoServicio.includes('psicométric');
            %>

            <% if (mostrarSocioeconomico || !mostrarPoligrafia && !mostrarPsicometrico) { %>
            <!-- Formulario Socioeconomico -->
            <div class="col-md-4">
                <div class="border rounded p-4 h-100 d-flex flex-column">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded p-2 me-3" style="background: rgba(59, 130, 246, 0.1);">
                            <i class="bi bi-house-door text-primary fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0">Socioeconomico</h6>
                            <small class="text-muted">
                                <% if (socioeconomico) { %>
                                    Estado: <%= socioeconomico.estado_formulario %>
                                <% } else { %>
                                    Sin iniciar
                                <% } %>
                            </small>
                        </div>
                    </div>
                    <p class="text-muted small flex-grow-1">Evaluacion del entorno socioeconomico del candidato.</p>
                    <a href="/encuestador/formularios/socioeconomico/<%= servicio.id_servicio %>" 
                       class="btn <%= socioeconomico && socioeconomico.estado_formulario === 'Finalizado' ? 'btn-outline-success' : 'btn-primary' %> mt-2">
                        <% if (socioeconomico && socioeconomico.estado_formulario === 'Finalizado') { %>
                            <i class="bi bi-eye me-1"></i>Ver Formulario
                        <% } else if (socioeconomico) { %>
                            <i class="bi bi-pencil me-1"></i>Continuar
                        <% } else { %>
                            <i class="bi bi-play me-1"></i>Iniciar
                        <% } %>
                    </a>
                </div>
            </div>
            <% } %>

            <% if (mostrarPoligrafia) { %>
            <!-- Formulario Poligrafia -->
            <div class="col-md-4">
                <div class="border rounded p-4 h-100 d-flex flex-column">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded p-2 me-3" style="background: rgba(139, 92, 246, 0.1);">
                            <i class="bi bi-bar-chart-line text-purple fs-4" style="color: #8b5cf6;"></i>
                        </div>
                        <div>
                            <h6 class="mb-0">Poligrafia</h6>
                            <small class="text-muted">
                                <% if (poligrafia) { %>
                                    Estado: <%= poligrafia.estado_formulario %>
                                <% } else { %>
                                    Sin iniciar
                                <% } %>
                            </small>
                        </div>
                    </div>
                    <p class="text-muted small flex-grow-1">Evaluacion de poligrafia con preguntas de veracidad.</p>
                    <a href="/encuestador/formularios/poligrafia/<%= servicio.id_servicio %>" 
                       class="btn <%= poligrafia && poligrafia.estado_formulario === 'Finalizado' ? 'btn-outline-success' : 'btn-primary' %> mt-2">
                        <% if (poligrafia && poligrafia.estado_formulario === 'Finalizado') { %>
                            <i class="bi bi-eye me-1"></i>Ver Formulario
                        <% } else if (poligrafia) { %>
                            <i class="bi bi-pencil me-1"></i>Continuar
                        <% } else { %>
                            <i class="bi bi-play me-1"></i>Iniciar
                        <% } %>
                    </a>
                </div>
            </div>
            <% } %>

            <% if (mostrarPsicometrico) { %>
            <!-- Formulario Psicometrico -->
            <div class="col-md-4">
                <div class="border rounded p-4 h-100 d-flex flex-column">
                    <div class="d-flex align-items-center mb-3">
                        <div class="rounded p-2 me-3" style="background: rgba(16, 185, 129, 0.1);">
                            <i class="bi bi-clipboard-data text-success fs-4"></i>
                        </div>
                        <div>
                            <h6 class="mb-0">Psicometrico</h6>
                            <small class="text-muted">
                                <% if (psicometrico) { %>
                                    Estado: <%= psicometrico.estado_formulario %>
                                <% } else { %>
                                    Sin iniciar
                                <% } %>
                            </small>
                        </div>
                    </div>
                    <p class="text-muted small flex-grow-1">Carga del reporte de evaluacion psicometrica.</p>
                    <a href="/encuestador/formularios/psicometrico/<%= servicio.id_servicio %>" 
                       class="btn <%= psicometrico && psicometrico.estado_formulario === 'Finalizado' ? 'btn-outline-success' : 'btn-primary' %> mt-2">
                        <% if (psicometrico && psicometrico.estado_formulario === 'Finalizado') { %>
                            <i class="bi bi-eye me-1"></i>Ver Formulario
                        <% } else if (psicometrico) { %>
                            <i class="bi bi-pencil me-1"></i>Continuar
                        <% } else { %>
                            <i class="bi bi-play me-1"></i>Iniciar
                        <% } %>
                    </a>
                </div>
            </div>
            <% } %>
        </div>
    </div>
</div>

<%- include('../../partials/encuestador-footer') %>
