<%- include('../../partials/encuestador-header') %>

<% const active = 'servicios'; %>

<div class="page-title">Mis Servicios Asignados</div>
<p class="page-subtitle">Servicios que te han sido asignados para completar</p>

<!-- Filtros -->
<div class="card mb-4">
    <div class="card-body">
        <form method="GET" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label">Estado</label>
                <select name="estado" class="form-select">
                    <option value="">Todos los estados</option>
                    <option value="Pendiente" <%= filtros.estado === 'Pendiente' ? 'selected' : '' %>>Pendiente</option>
                    <option value="En proceso" <%= filtros.estado === 'En proceso' ? 'selected' : '' %>>En proceso</option>
                    <option value="Finalizado" <%= filtros.estado === 'Finalizado' ? 'selected' : '' %>>Finalizado</option>
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Tipo de Servicio</label>
                <select name="tipo" class="form-select">
                    <option value="">Todos los tipos</option>
                    <% tiposServicio.forEach(function(tipo) { %>
                        <option value="<%= tipo.id_tipo_servicio %>" <%= filtros.tipo == tipo.id_tipo_servicio ? 'selected' : '' %>>
                            <%= tipo.tipo_servicio %>
                        </option>
                    <% }); %>
                </select>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-2"></i>Filtrar
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Lista de Servicios -->
<% if (servicios.length > 0) { %>
    <div class="row g-3">
        <% servicios.forEach(function(servicio) { 
            // Calcular dias restantes del vencimiento
            let diasRestantes = null;
            let vencBadge = '';
            const vencido = servicio.fecha_limite && servicio.estado_servicio !== 'Finalizado' && servicio.estado_servicio !== 'Cancelado' &&
                (() => { const h = new Date(); h.setHours(0,0,0,0); const l = new Date(servicio.fecha_limite); l.setHours(0,0,0,0); return l < h; })();
            if (servicio.fecha_limite && servicio.estado_servicio !== 'Finalizado' && servicio.estado_servicio !== 'Cancelado') {
                const hoy = new Date();
                hoy.setHours(0, 0, 0, 0);
                const limite = new Date(servicio.fecha_limite);
                limite.setHours(0, 0, 0, 0);
                diasRestantes = Math.ceil((limite - hoy) / 86400000);
            }
        %>
            <div class="col-12">
                <% if (vencido) { %>
                <div class="alert alert-danger py-1 px-2 mb-1 small rounded-top rounded-bottom-0 mb-0">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    Plazo vencido hace <%= Math.abs(diasRestantes) %> día(s)
                </div>
                <% } %>
                <a href="/encuestador/servicios/<%= servicio.id_servicio %>" class="service-card<%= vencido ? ' rounded-top-0 border-danger border-top-0' : '' %>">
                    <div class="d-flex flex-column flex-md-row align-items-start align-items-md-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle d-flex align-items-center justify-content-center" 
                                 style="width: 50px; height: 50px; background: rgba(5, 150, 105, 0.1); color: #059669; font-weight: bold; font-size: 1.2rem;">
                                <%= servicio.candidato_nombre ? servicio.candidato_nombre.charAt(0) : 'C' %>
                            </div>
                            <div>
                                <h5 class="mb-1 fw-bold"><%= servicio.candidato_nombre %></h5>
                                <p class="mb-0 text-muted small">
                                    <i class="bi bi-briefcase me-1"></i><%= servicio.tipo_servicio %>
                                </p>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-3">
                            <div class="text-md-end">
                                <div class="fw-medium"><%= servicio.empresa %></div>
                                <div class="text-muted small">
                                    <i class="bi bi-geo-alt me-1"></i><%= servicio.ciudad %>
                                </div>
                            </div>
                            <!-- Badge de vencimiento -->
                            <% if (diasRestantes !== null) { %>
                                <% if (diasRestantes < 0) { %>
                                    <span class="badge bg-danger"><i class="bi bi-exclamation-triangle me-1"></i>Vencido</span>
                                <% } else if (diasRestantes <= 2) { %>
                                    <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i><%= diasRestantes %> dias</span>
                                <% } else { %>
                                    <span class="badge bg-secondary"><i class="bi bi-calendar me-1"></i><%= diasRestantes %> dias</span>
                                <% } %>
                            <% } %>
                            <span class="badge 
                                <% if (servicio.estado_servicio === 'Pendiente') { %>bg-warning text-dark
                                <% } else if (servicio.estado_servicio === 'En proceso') { %>bg-info
                                <% } else if (servicio.estado_servicio === 'Finalizado') { %>bg-success
                                <% } else { %>bg-danger<% } %>">
                                <%= servicio.estado_servicio %>
                            </span>
                            <i class="bi bi-chevron-right text-muted"></i>
                        </div>
                    </div>
                </a>
            </div>
        <% }); %>
    </div>
<% } else { %>
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-inbox" style="font-size: 4rem; color: #e2e8f0;"></i>
            <h5 class="mt-3 text-muted">No tienes servicios asignados</h5>
            <p class="text-muted">Los servicios apareceran aqui cuando te sean asignados</p>
        </div>
    </div>
<% } %>


<% if (totalPages > 1) { %>
<nav class="mt-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
  <small class="text-muted">Mostrando <%= (page-1)*5+1 %>–<%= Math.min(page*5, total) %> de <%= total %> servicios</small>
  <ul class="pagination pagination-sm mb-0">
    <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
      <a class="page-link" href="?<%= new URLSearchParams({...filtros, page: page-1}).toString() %>"><i class="bi bi-chevron-left"></i></a>
    </li>
    <% for(let i = 1; i <= totalPages; i++) { %>
      <% if (i === 1 || i === totalPages || (i >= page-2 && i <= page+2)) { %>
        <li class="page-item <%= i === page ? 'active' : '' %>">
          <a class="page-link" href="?<%= new URLSearchParams({...filtros, page: i}).toString() %>"><%= i %></a>
        </li>
      <% } else if (i === page-3 || i === page+3) { %>
        <li class="page-item disabled"><span class="page-link">…</span></li>
      <% } %>
    <% } %>
    <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
      <a class="page-link" href="?<%= new URLSearchParams({...filtros, page: page+1}).toString() %>"><i class="bi bi-chevron-right"></i></a>
    </li>
  </ul>
</nav>
<% } %>

<%- include('../../partials/encuestador-footer') %>
