<%- include('../partials/encuestador-header', { title: 'Mi Perfil - SECU' }) %>

<% const active = 'perfil'; %>

<div class="page-title">Mi Perfil</div>
<p class="page-subtitle">Información personal y datos de contacto</p>

<!-- Avatar -->
<div class="card mb-4">
  <div class="card-body d-flex align-items-center gap-4">
    <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold"
      style="width:72px;height:72px;font-size:1.8rem;flex-shrink:0;background:#059669;">
      <%= empleado.p_nombre.charAt(0).toUpperCase() %><%= empleado.p_apellido.charAt(0).toUpperCase() %>
    </div>
    <div>
      <h5 class="mb-1"><%= empleado.p_nombre %> <%= empleado.s_nombre || '' %> <%= empleado.p_apellido %> <%= empleado.s_apellido || '' %></h5>
      <span class="text-muted"><%= empleado.puesto %></span><br>
      <small class="text-muted">Usuario: <strong><%= empleado.usuario %></strong></small>
    </div>
  </div>
</div>

<div class="row g-4">
  <!-- Datos solo lectura -->
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header">Información Personal</div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-6">
            <label class="form-label text-muted small">DNI</label>
            <p class="fw-medium mb-0"><%= empleado.dni %></p>
          </div>
          <div class="col-6">
            <label class="form-label text-muted small">Género</label>
            <p class="fw-medium mb-0"><%= empleado.genero || '—' %></p>
          </div>
          <div class="col-6">
            <label class="form-label text-muted small">Fecha de Nacimiento</label>
            <p class="fw-medium mb-0"><%= new Date(empleado.fecha_nacimiento).toLocaleDateString('es-HN') %></p>
          </div>
          <div class="col-6">
            <label class="form-label text-muted small">Fecha Contratación</label>
            <p class="fw-medium mb-0"><%= new Date(empleado.fecha_contratacion).toLocaleDateString('es-HN') %></p>
          </div>
          <div class="col-12">
            <label class="form-label text-muted small">Estado</label><br>
            <span class="badge <%= empleado.estado_empleado ? 'bg-success' : 'bg-danger' %>">
              <%= empleado.estado_empleado ? 'Activo' : 'Inactivo' %>
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Formulario editable -->
  <div class="col-md-6">
    <div class="card h-100">
      <div class="card-header">Datos de Contacto</div>
      <div class="card-body">
        <form method="POST" action="/encuestador/perfil">
          <div class="mb-3">
            <label class="form-label">Correo Electrónico</label>
            <input type="email" name="correo" value="<%= empleado.correo %>" class="form-control">
          </div>
          <div class="mb-3">
            <label class="form-label">Teléfono</label>
            <input type="text" name="telefono" value="<%= empleado.telefono %>" class="form-control">
          </div>
          <div class="mb-3">
            <label class="form-label">Dirección</label>
            <input type="text" name="direccion" value="<%= empleado.direccion %>" class="form-control">
          </div>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">
              <i class="bi bi-save me-2"></i>Guardar Cambios
            </button>
            <a href="/cambiar-contrasenia" class="btn btn-outline-secondary">
              <i class="bi bi-key me-2"></i>Cambiar Contraseña
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/encuestador-footer') %>
