<%- include('../../partials/encuestador-header') %>

<% 
const active = 'servicios';

// Agrupar preguntas por categoria
const categoriasData = {};
preguntas.forEach(p => {
  if (!categoriasData[p.categoria]) {
    categoriasData[p.categoria] = [];
  }
  categoriasData[p.categoria].push(p);
});
const nombresCategorias = Object.keys(categoriasData);
// La última "categoría" es la de resultado — se agrega al final
const totalBloques = nombresCategorias.length + 1; // +1 para el bloque de resultado
%>

<div class="mb-4">
    <a href="/encuestador/servicios/<%= servicio.id_servicio %>" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i>Volver al Servicio
    </a>
</div>

<div class="page-title">Formulario de Poligrafia</div>
<p class="page-subtitle">
    Candidato: <strong><%= servicio.p_nombre %> <%= servicio.p_apellido %></strong> | 
    DNI: <%= servicio.dni %>
</p>

<!-- Informacion del servicio -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row">
            <div class="col-6 col-md-3">
                <small class="text-muted">Empresa</small>
                <div class="fw-bold"><%= servicio.empresa %></div>
            </div>
            <div class="col-6 col-md-3">
                <small class="text-muted">Tipo de Servicio</small>
                <div class="fw-bold"><%= servicio.tipo_servicio %></div>
            </div>
            <div class="col-6 col-md-3">
                <small class="text-muted">Estado Formulario</small>
                <div>
                    <span class="badge <%= formulario.estado_formulario === 'Finalizado' ? 'bg-success' : 'bg-warning text-dark' %>">
                        <%= formulario.estado_formulario %>
                    </span>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <small class="text-muted">Ultima Actualizacion</small>
                <div class="fw-bold" id="ultimaActualizacion">
                    <%= new Date(formulario.fecha_ultima_actualizacion).toLocaleString('es-HN') %>
                </div>
            </div>
        </div>
    </div>
</div>

<% if (formulario.estado_formulario === 'Finalizado') { %>
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>
        Este formulario ya fue finalizado y no puede ser modificado.
    </div>
<% } %>

<!-- Indicador de progreso -->
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="progress mb-2" style="height: 8px;">
            <div class="progress-bar bg-primary transition-width" id="barraProgreso" style="width: 0%; transition: width 0.3s ease;"></div>
        </div>
        <p class="text-muted small mb-0" id="indicadorCategoria"></p>
    </div>
</div>

<form id="formPoligrafia" method="POST" action="/encuestador/formularios/poligrafia/<%= servicio.id_servicio %>">
    <input type="hidden" name="tiempo_llenado_segundos" id="tiempoLlenado" value="<%= formulario.tiempo_llenado_segundos || 0 %>">

    <!-- ── Bloques por categoría ─────────────────────────────────────── -->
    <% nombresCategorias.forEach((categoria, idx) => { %>
        <div class="categoria-bloque" data-idx="<%= idx %>">
            <div class="card mb-3">
                <div class="card-header bg-light">
                    <h6 class="mb-0">
                        <i class="bi bi-list-check me-2"></i><%= idx + 1 %>. <%= categoria %>
                    </h6>
                </div>
                <div class="card-body">
                    <% categoriasData[categoria].forEach(pregunta => { %>
                        <div class="mb-3 pb-3 border-bottom">
                            <div class="d-flex justify-content-between align-items-start">
                                <div class="me-3" style="flex: 1;">
                                    <strong class="text-muted small">Pregunta <%= pregunta.numero %></strong>
                                    <p class="mb-0"><%= pregunta.pregunta %></p>
                                </div>
                                <div class="btn-group" role="group">
                                    <input type="radio" class="btn-check" name="respuestas[<%= pregunta.numero %>]" 
                                           id="respuesta_<%= pregunta.numero %>_si" value="true"
                                           <%= respuestas[pregunta.numero] === true ? 'checked' : '' %>
                                           <%= formulario.estado_formulario === 'Finalizado' ? 'disabled' : '' %>>
                                    <label class="btn btn-outline-success btn-sm" for="respuesta_<%= pregunta.numero %>_si">Si</label>
                                    
                                    <input type="radio" class="btn-check" name="respuestas[<%= pregunta.numero %>]" 
                                           id="respuesta_<%= pregunta.numero %>_no" value="false"
                                           <%= respuestas[pregunta.numero] === false ? 'checked' : '' %>
                                           <%= formulario.estado_formulario === 'Finalizado' ? 'disabled' : '' %>>
                                    <label class="btn btn-outline-danger btn-sm" for="respuesta_<%= pregunta.numero %>_no">No</label>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            </div>
        </div>
    <% }); %>

    <!-- ── Bloque final: Resultado ───────────────────────────────────── -->
    <div class="categoria-bloque" data-idx="<%= nombresCategorias.length %>">
        <div class="card mb-3">
            <div class="card-header bg-primary text-white">
                <h6 class="mb-0">
                    <i class="bi bi-clipboard-check me-2"></i>Resultado de la Evaluacion
                </h6>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Nivel de Veracidad General (1-10)</label>
                        <input type="range" class="form-range" name="nivel_veracidad_general" 
                               min="1" max="10" value="<%= formulario.nivel_veracidad_general || 5 %>"
                               id="nivelVeracidad"
                               <%= formulario.estado_formulario === 'Finalizado' ? 'disabled' : '' %>>
                        <div class="text-center">
                            <span id="nivelVeracidadValue" class="badge bg-primary fs-5">
                                <%= formulario.nivel_veracidad_general || 5 %>
                            </span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Resultado Final</label>
                        <select name="resultado" class="form-select" required
                                <%= formulario.estado_formulario === 'Finalizado' ? 'disabled' : '' %>>
                            <option value="Verdad" <%= formulario.resultado === 'Verdad' ? 'selected' : '' %>>Verdad</option>
                            <option value="Engaño" <%= formulario.resultado === 'Engaño' ? 'selected' : '' %>>Engaño</option>
                            <option value="Inconcluso" <%= formulario.resultado === 'Inconcluso' ? 'selected' : '' %>>Inconcluso</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <label class="form-label">Comentarios y Observaciones</label>
                        <textarea name="comentarios" class="form-control" rows="4" 
                                  placeholder="Ingrese comentarios adicionales sobre la evaluacion..."
                                  <%= formulario.estado_formulario === 'Finalizado' ? 'disabled' : '' %>><%= formulario.comentarios || '' %></textarea>
                    </div>

                    <% if (formulario.estado_formulario !== 'Finalizado') { %>
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <span id="autoguardadoStatus" class="text-muted small">
                                <i class="bi bi-cloud-check me-1"></i>Autoguardado activado
                            </span>
                            <div class="d-flex gap-2">
                                <%# Bug 3 fix: solo "Guardar Borrador" aquí. "Finalizar" únicamente en la barra de navegación (btnFinalizar) %>
                                <button type="submit" name="finalizar" value="false" class="btn btn-outline-primary">
                                    <i class="bi bi-save me-2"></i>Guardar Borrador
                                </button>
                            </div>
                        </div>
                    </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Navegación entre categorías ──────────────────────────────── -->
    <div class="d-flex justify-content-between align-items-center mt-2 mb-4">
        <button type="button" class="btn btn-outline-secondary" id="btnAnterior" onclick="navegarCategoria(-1)">
            <i class="bi bi-chevron-left me-1"></i>Anterior
        </button>
        <button type="button" class="btn btn-primary" id="btnSiguiente" onclick="navegarCategoria(1)">
            Siguiente<i class="bi bi-chevron-right ms-1"></i>
        </button>
        <!-- btnFinalizar solo aparece en el último bloque si no está finalizado -->
        <% if (formulario.estado_formulario !== 'Finalizado') { %>
        <button type="button" class="btn btn-success" id="btnFinalizar" style="display:none"
                data-bs-toggle="modal" data-bs-target="#confirmarFinalizar">
            <i class="bi bi-check-circle me-2"></i>Finalizar Evaluacion
        </button>
        <% } else { %>
        <span id="btnFinalizar" style="display:none"></span>
        <% } %>
    </div>

</form>

<!-- Modal de confirmacion -->
<div class="modal fade" id="confirmarFinalizar" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Finalizacion</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Esta seguro de finalizar esta evaluacion de poligrafia?</p>
                <p class="text-warning"><i class="bi bi-exclamation-triangle me-2"></i>Una vez finalizada, no podra modificar las respuestas.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" onclick="finalizarFormulario()">
                    <i class="bi bi-check-circle me-2"></i>Si, Finalizar
                </button>
            </div>
        </div>
    </div>
</div>

<script>
// ── Datos de categorías ───────────────────────────────────────────────────
const categorias = <%- JSON.stringify(nombresCategorias.concat(['Resultado de la Evaluacion'])) %>;
let categoriaActual = 0;
const bloques = document.querySelectorAll('.categoria-bloque');
const totalBloques = bloques.length;

function mostrarCategoria(idx) {
    bloques.forEach((el, i) => {
        el.style.display = i === idx ? 'block' : 'none';
    });

    const btnAnterior  = document.getElementById('btnAnterior');
    const btnSiguiente = document.getElementById('btnSiguiente');
    const btnFinalizar = document.getElementById('btnFinalizar');

    btnAnterior.disabled = idx === 0;
    btnSiguiente.style.display = idx === totalBloques - 1 ? 'none' : 'inline-block';
    if (btnFinalizar) {
        btnFinalizar.style.display = idx === totalBloques - 1 ? 'inline-block' : 'none';
    }

    // Progreso
    const pct = Math.round(((idx + 1) / totalBloques) * 100);
    document.getElementById('barraProgreso').style.width = pct + '%';
    document.getElementById('indicadorCategoria').textContent =
        `Categoría ${idx + 1} de ${totalBloques}: ${categorias[idx]}`;

    categoriaActual = idx;
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

function navegarCategoria(delta) {
    const nuevo = categoriaActual + delta;
    if (nuevo >= 0 && nuevo < totalBloques) {
        mostrarCategoria(nuevo);
    }
}

// Inicializar en la primera categoría
mostrarCategoria(0);

// ── Slider de veracidad ───────────────────────────────────────────────────
document.getElementById('nivelVeracidad').addEventListener('input', function() {
    document.getElementById('nivelVeracidadValue').textContent = this.value;
});

// ── Autoguardado cada 30 segundos ────────────────────────────────────────
<% if (formulario.estado_formulario !== 'Finalizado') { %>
let autoguardadoTimer;

function autoguardar() {
    const form = document.getElementById('formPoligrafia');
    const formData = new FormData(form);
    formData.append('finalizar', 'false');

    document.getElementById('autoguardadoStatus').innerHTML =
        '<i class="bi bi-arrow-repeat me-1 spinner-border spinner-border-sm"></i>Guardando...';

    fetch('/encuestador/formularios/poligrafia/<%= servicio.id_servicio %>', {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' }
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            document.getElementById('autoguardadoStatus').innerHTML =
                '<i class="bi bi-cloud-check me-1 text-success"></i>Guardado ' + new Date().toLocaleTimeString();
        }
    })
    .catch(() => {
        document.getElementById('autoguardadoStatus').innerHTML =
            '<i class="bi bi-exclamation-triangle me-1 text-danger"></i>Error al guardar';
    });
}

autoguardadoTimer = setInterval(autoguardar, 30000);

document.querySelectorAll('input, select, textarea').forEach(el => {
    el.addEventListener('change', () => {
        clearTimeout(autoguardadoTimer);
        autoguardadoTimer = setTimeout(autoguardar, 5000);
    });
});
<% } %>

function finalizarFormulario() {
    const form = document.getElementById('formPoligrafia');
    const input = document.createElement('input');
    input.type  = 'hidden';
    input.name  = 'finalizar';
    input.value = 'true';
    form.appendChild(input);
    form.submit();
}
</script>

<% if (formulario.estado_formulario !== 'Finalizado') { %>
<div class="position-fixed bg-dark text-white rounded px-3 py-2 d-flex align-items-center gap-2"
     style="top: 70px; right: 20px; z-index: 1050; font-size: 0.9rem; opacity: 0.85;">
  <i class="bi bi-stopwatch"></i>
  <span id="displayTimer">0:00</span>
</div>
<script>
  let segundosTimer = parseInt(document.getElementById('tiempoLlenado').value) || 0;
  (function() {
    const m = Math.floor(segundosTimer / 60);
    const s = segundosTimer % 60;
    document.getElementById('displayTimer').textContent = m + ':' + String(s).padStart(2, '0');
  })();
  const intervalTimer = setInterval(() => {
    segundosTimer++;
    document.getElementById('tiempoLlenado').value = segundosTimer;
    const m = Math.floor(segundosTimer / 60);
    const s = segundosTimer % 60;
    document.getElementById('displayTimer').textContent = m + ':' + String(s).padStart(2, '0');
  }, 1000);
  document.querySelector('form').addEventListener('submit', () => clearInterval(intervalTimer));
</script>
<% } %>

<%- include('../../partials/encuestador-footer') %>
