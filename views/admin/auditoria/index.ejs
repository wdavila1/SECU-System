<%- include('../../partials/admin-header', { active: 'auditoria' }) %>

<style>
  .nav-tabs .nav-link { color: #495057 !important; background: #f8f9fa; border: 1px solid #dee2e6; }
  .nav-tabs .nav-link.active { color: #fff !important; background: var(--bs-primary); border-color: var(--bs-primary); }
  .nav-tabs .nav-link:hover:not(.active) { color: #212529 !important; background: #e9ecef; }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="page-title">Auditoría del Sistema</h1>
    <p class="page-subtitle mb-0">Registro de actividades y modificaciones</p>
  </div>
</div>

<div class="card mb-4">
  <div class="card-body">
    <form action="/admin/auditoria" method="GET" class="row g-3 align-items-end">
      
      <div class="col">
        <label class="form-label text-muted small fw-bold">Fecha Inicio</label>
        <input type="date" class="form-control" name="fecha_inicio" value="<%= filtros.fecha_inicio || '' %>">
      </div>

      <div class="col">
        <label class="form-label text-muted small fw-bold">Fecha Fin</label>
        <input type="date" class="form-control" name="fecha_fin" value="<%= filtros.fecha_fin || '' %>">
      </div>

      <div class="col-auto d-flex gap-2">
        
        <button type="submit" class="btn btn-primary d-flex align-items-center justify-content-center" 
                style="min-width: 160px; height: 38px;">
          <i class="bi bi-search me-2"></i> Filtrar
        </button>

        <a href="/admin/auditoria" 
           class="btn btn-outline-secondary d-flex align-items-center justify-content-center" 
           style="width: 38px; height: 38px; min-width: 38px; padding: 0;" 
           title="Limpiar filtros">
          <i class="bi bi-x-lg"></i>
        </a>
      </div>

    </form>
  </div>
</div>

<!-- Tabs -->
<ul class="nav nav-tabs mb-4" role="tablist" style="border-bottom: 2px solid #dee2e6;">
  <li class="nav-item" role="presentation">
    <button class="nav-link fw-semibold <%= typeof activeTab !== 'undefined' && activeTab === 'mod' ? '' : 'active' %>"
            id="login-tab" data-bs-toggle="tab" data-bs-target="#login" type="button" role="tab"
            style="margin-right: 4px;">
      <i class="bi bi-box-arrow-in-right me-2"></i>Actividad de Login
      <span class="badge bg-secondary ms-1"><%= totalLogin %></span>
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link fw-semibold <%= typeof activeTab !== 'undefined' && activeTab === 'mod' ? 'active' : '' %>"
            id="mod-tab" data-bs-toggle="tab" data-bs-target="#modificaciones" type="button" role="tab">
      <i class="bi bi-pencil-square me-2"></i>Acciones Manuales
      <span class="badge bg-secondary ms-1"><%= totalMod %></span>
    </button>
  </li>
</ul>

<div class="tab-content">

  <!-- ══════════════════════════════════════════════════════════════
       TAB LOGIN
  ══════════════════════════════════════════════════════════════ -->
  <div class="tab-pane fade <%= typeof activeTab !== 'undefined' && activeTab === 'mod' ? '' : 'show active' %>"
       id="login" role="tabpanel">
    <div class="card">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0 align-middle">
            <thead>
              <tr>
                <th>Usuario</th>
                <th>IP</th>
                <th>Empleado</th>
                <th>Inicio de Sesión</th>
                <th>Cierre de Sesión</th>
                <th>Duración</th>
              </tr>
            </thead>
            <tbody>
              <% if (loginActividad.length > 0) { %>
                <% loginActividad.forEach(log => {
                  const inicio = new Date(log.fecha_inicio_sesion);
                  const fin    = log.fecha_cierra_sesion ? new Date(log.fecha_cierra_sesion) : null;
                  let duracion = '';
                  let esInterrumpida = false;

                  if (fin) {
                    const diffMin = Math.floor((fin - inicio) / 60000);
                    // Si la diferencia es exactamente 480 min (8h) → sesión cerrada automáticamente
                    esInterrumpida = (diffMin === 480);
                    duracion = diffMin < 60
                      ? `${diffMin} min`
                      : `${Math.floor(diffMin/60)}h ${diffMin%60}min`;
                  }
                %>
                  <tr>
                    <td><code><%= log.usuario %></code></td>
                    <td>
                      <% if (log.ip_address) { %>
                        <code class="text-muted small"><%= log.ip_address %></code>
                      <% } else { %>
                        <span class="text-muted">—</span>
                      <% } %>
                    </td>
                    <td><%= log.empleado_nombre %></td>
                    <td>
                      <i class="bi bi-box-arrow-in-right text-success me-1"></i>
                      <%= inicio.toLocaleString('es-HN') %>
                    </td>
                    <td>
                      <% if (esInterrumpida) { %>
                        <span class="badge bg-warning text-dark">
                          <i class="bi bi-exclamation-triangle me-1"></i>Sesión interrumpida
                        </span>
                      <% } else if (fin) { %>
                        <i class="bi bi-box-arrow-left text-danger me-1"></i>
                        <%= fin.toLocaleString('es-HN') %>
                      <% } else { %>
                        <span class="badge bg-success">
                          <i class="bi bi-circle-fill me-1" style="font-size:.5rem"></i>Sesión activa
                        </span>
                      <% } %>
                    </td>
                    <td>
                      <% if (esInterrumpida) { %>
                        <span class="text-muted small">—</span>
                      <% } else if (duracion) { %>
                        <span class="text-muted"><%= duracion %></span>
                      <% } else { %>
                        <span class="text-muted">—</span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="6" class="text-center py-5">
                    <i class="bi bi-clock-history" style="font-size: 3rem; color: #94a3b8;"></i>
                    <p class="text-muted mt-2">No hay registros de actividad</p>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Paginador Login -->
        <% if (totalPagesLogin > 1) { %>
        <nav class="mt-3 px-3 pb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
          <small class="text-muted">Mostrando <%= (pageLogin-1)*10+1 %>–<%= Math.min(pageLogin*10, totalLogin) %> de <%= totalLogin %> registros</small>
          <ul class="pagination pagination-sm mb-0">
            <li class="page-item <%= pageLogin <= 1 ? 'disabled' : '' %>">
              <a class="page-link" href="?<%= new URLSearchParams({...filtros, page_login: pageLogin-1, page_mod: pageMod, tab: 'login'}).toString() %>">
                <i class="bi bi-chevron-left"></i>
              </a>
            </li>
            <% for(let i = 1; i <= totalPagesLogin; i++) { %>
              <% if (i === 1 || i === totalPagesLogin || (i >= pageLogin-2 && i <= pageLogin+2)) { %>
                <li class="page-item <%= i === pageLogin ? 'active' : '' %>">
                  <a class="page-link" href="?<%= new URLSearchParams({...filtros, page_login: i, page_mod: pageMod, tab: 'login'}).toString() %>"><%= i %></a>
                </li>
              <% } else if (i === pageLogin-3 || i === pageLogin+3) { %>
                <li class="page-item disabled"><span class="page-link">…</span></li>
              <% } %>
            <% } %>
            <li class="page-item <%= pageLogin >= totalPagesLogin ? 'disabled' : '' %>">
              <a class="page-link" href="?<%= new URLSearchParams({...filtros, page_login: pageLogin+1, page_mod: pageMod, tab: 'login'}).toString() %>">
                <i class="bi bi-chevron-right"></i>
              </a>
            </li>
          </ul>
        </nav>
        <% } %>

      </div>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════════
       TAB MODIFICACIONES
  ══════════════════════════════════════════════════════════════ -->
  <div class="tab-pane fade <%= typeof activeTab !== 'undefined' && activeTab === 'mod' ? 'show active' : '' %>"
       id="modificaciones" role="tabpanel">
    <div class="card">
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover mb-0 align-middle">
            <thead>
              <tr>
                <th>Fecha</th>
                <th>Usuario</th>
                <th>Tabla</th>
                <th>Registro</th>
                <th>Campo</th>
                <th>Valor Anterior</th>
                <th>Valor Nuevo</th>
              </tr>
            </thead>
            <tbody>
              <% if (historialModificaciones.length > 0) { %>
                <% historialModificaciones.forEach(mod => { %>
                  <tr>
                    <td><%= new Date(mod.fecha_modificacion).toLocaleString('es-HN') %></td>
                    <td>
                      <code><%= mod.usuario %></code>
                      <small class="d-block text-muted"><%= mod.empleado_nombre %></small>
                    </td>
                    <td><span class="badge bg-primary"><%= mod.tabla_modificada %></span></td>
                    <td>#<%= mod.id_registro %></td>
                    <td><%= mod.campo_modificado %></td>
                    <td>
                      <% if (mod.valor_anterior) { %>
                        <span class="text-danger"><%= mod.valor_anterior.substring(0, 50) %><%= mod.valor_anterior.length > 50 ? '…' : '' %></span>
                      <% } else { %>
                        <span class="text-muted">—</span>
                      <% } %>
                    </td>
                    <td>
                      <% if (mod.valor_nuevo) { %>
                        <span class="text-success"><%= mod.valor_nuevo.substring(0, 50) %><%= mod.valor_nuevo.length > 50 ? '…' : '' %></span>
                      <% } else { %>
                        <span class="text-muted">—</span>
                      <% } %>
                    </td>
                  </tr>
                <% }); %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="text-center py-5">
                    <i class="bi bi-pencil-square" style="font-size: 3rem; color: #94a3b8;"></i>
                    <p class="text-muted mt-2">No hay registros de modificaciones</p>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- Paginador Modificaciones -->
        <% if (totalPagesMod > 1) { %>
        <nav class="mt-3 px-3 pb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
          <small class="text-muted">Mostrando <%= (pageMod-1)*10+1 %>–<%= Math.min(pageMod*10, totalMod) %> de <%= totalMod %> registros</small>
          <ul class="pagination pagination-sm mb-0">
            <li class="page-item <%= pageMod <= 1 ? 'disabled' : '' %>">
              <a class="page-link" href="?<%= new URLSearchParams({...filtros, page_login: pageLogin, page_mod: pageMod-1, tab: 'mod'}).toString() %>">
                <i class="bi bi-chevron-left"></i>
              </a>
            </li>
            <% for(let i = 1; i <= totalPagesMod; i++) { %>
              <% if (i === 1 || i === totalPagesMod || (i >= pageMod-2 && i <= pageMod+2)) { %>
                <li class="page-item <%= i === pageMod ? 'active' : '' %>">
                  <a class="page-link" href="?<%= new URLSearchParams({...filtros, page_login: pageLogin, page_mod: i, tab: 'mod'}).toString() %>"><%= i %></a>
                </li>
              <% } else if (i === pageMod-3 || i === pageMod+3) { %>
                <li class="page-item disabled"><span class="page-link">…</span></li>
              <% } %>
            <% } %>
            <li class="page-item <%= pageMod >= totalPagesMod ? 'disabled' : '' %>">
              <a class="page-link" href="?<%= new URLSearchParams({...filtros, page_login: pageLogin, page_mod: pageMod+1, tab: 'mod'}).toString() %>">
                <i class="bi bi-chevron-right"></i>
              </a>
            </li>
          </ul>
        </nav>
        <% } %>

      </div>
    </div>
  </div>

</div>

<script>
// Activar el tab correcto según el parámetro ?tab=
(function() {
  const params = new URLSearchParams(window.location.search);
  const tab = params.get('tab');
  if (tab === 'mod') {
    const modTab = document.getElementById('mod-tab');
    const loginTab = document.getElementById('login-tab');
    if (modTab && loginTab) {
      loginTab.classList.remove('active');
      document.getElementById('login').classList.remove('show', 'active');
      modTab.classList.add('active');
      document.getElementById('modificaciones').classList.add('show', 'active');
    }
  }
})();
</script>

<%- include('../../partials/admin-footer') %>
