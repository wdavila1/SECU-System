<%- include('../../partials/admin-header', { active: 'empresas' }) %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="page-title">Gestión de Empresas</h1>
    <p class="page-subtitle mb-0">Administra las empresas clientes del sistema</p>
  </div>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#nuevaEmpresaModal">
    <i class="bi bi-plus-lg me-2"></i>Nueva Empresa
  </button>
</div>

<!-- Filtros -->
<div class="card mb-4">
  <div class="card-body">
    <form action="/admin/empresas" method="GET" class="row g-3 align-items-end">
      
      <div class="col">
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-search"></i></span>
          <input type="text" class="form-control" name="buscar" placeholder="Buscar empresa..." value="<%= filtros.buscar || '' %>">
        </div>
      </div>

      <div class="col-auto d-flex gap-2">
        
        <button type="submit" class="btn btn-primary d-flex align-items-center justify-content-center" 
                style="min-width: 160px; height: 38px;">
          <i class="bi bi-search me-2"></i> Filtrar
        </button>

        <a href="/admin/empresas" 
           class="btn btn-outline-secondary d-flex align-items-center justify-content-center" 
           style="width: 38px; height: 38px; min-width: 38px; padding: 0;" 
           title="Limpiar filtros">
          <i class="bi bi-x-lg"></i>
        </a>
      </div>

    </form>
  </div>
</div>

<!-- Lista de Empresas -->
<div class="row g-4">
  <% if (empresas.length > 0) { %>
    <% empresas.forEach(empresa => { %>
      <div class="col-md-6 col-lg-4">
        <div class="card h-100">
          <div class="card-body">
            <div class="d-flex align-items-start">
              <div class="me-3" style="width: 50px; height: 50px; background: linear-gradient(135deg, #3b82f6, #8b5cf6); border-radius: 10px; display: flex; align-items: center; justify-content: center; color: white; font-size: 1.3rem;">
                <i class="bi bi-building"></i>
              </div>
              <div class="flex-grow-1">
                <h5 class="card-title mb-1"><%= empresa.empresa %></h5>
                <small class="text-muted">ID: <%= empresa.id_empresa %></small>
              </div>
            </div>
          </div>
          <div class="card-footer bg-transparent border-top-0">
            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editarModal<%= empresa.id_empresa %>">
              <i class="bi bi-pencil me-1"></i>Editar
            </button>
          </div>
        </div>
        
        <!-- Modal Editar -->
        <div class="modal fade" id="editarModal<%= empresa.id_empresa %>" tabindex="-1">
          <div class="modal-dialog">
            <div class="modal-content">
              <form action="/admin/empresas/editar/<%= empresa.id_empresa %>" method="POST">
                <div class="modal-header">
                  <h5 class="modal-title">Editar Empresa</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                  <div class="mb-3">
                    <label class="form-label">Nombre de la Empresa *</label>
                    <input type="text" class="form-control" name="empresa" value="<%= empresa.empresa %>" required>
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                  <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
  <% } else { %>
    <div class="col-12">
      <div class="card">
        <div class="card-body text-center py-5">
          <i class="bi bi-building" style="font-size: 4rem; color: #94a3b8;"></i>
          <h4 class="mt-3 text-muted">No hay empresas registradas</h4>
          <p class="text-muted">Comience agregando una nueva empresa</p>
          <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#nuevaEmpresaModal">
            <i class="bi bi-plus-lg me-2"></i>Nueva Empresa
          </button>
        </div>
      </div>
    </div>
  <% } %>
</div>

<!-- Modal Nueva Empresa -->
<div class="modal fade" id="nuevaEmpresaModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/admin/empresas" method="POST">
        <div class="modal-header">
          <h5 class="modal-title">Nueva Empresa</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Nombre de la Empresa *</label>
            <input type="text" class="form-control" name="empresa" placeholder="Ingrese el nombre de la empresa" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar Empresa</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../../partials/admin-footer') %>
