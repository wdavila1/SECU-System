<%- include('../partials/admin-header', { active: 'dashboard' }) %>

<h1 class="page-title">Panel de Control</h1>
<p class="page-subtitle">Resumen general de actividades y metricas del sistema SECU</p>

<!-- Stats Cards -->
<div class="row g-4 mb-4">
  <div class="col-md-6 col-lg-3">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-start">
        <div class="icon" style="background: #3b82f6;">
          <i class="bi bi-briefcase"></i>
        </div>
        <span class="badge bg-success-subtle text-success">Este mes</span>
      </div>
      <div class="value mt-3"><%= serviciosMes %></div>
      <div class="label">Servicios del mes</div>
    </div>
  </div>
  
  <div class="col-md-6 col-lg-3">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-start">
        <div class="icon" style="background: #f59e0b;">
          <i class="bi bi-clock-history"></i>
        </div>
        <span class="badge bg-warning-subtle text-warning">Pendientes</span>
      </div>
      <div class="value mt-3"><%= serviciosPendientes %></div>
      <div class="label">Servicios pendientes</div>
    </div>
  </div>
  
  <div class="col-md-6 col-lg-3">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-start">
        <div class="icon" style="background: #10b981;">
          <i class="bi bi-file-earmark-text"></i>
        </div>
        <span class="badge bg-primary-subtle text-primary">Cotizado</span>
      </div>
      <div class="value mt-3">L.<%= parseFloat(cotizacionesTotal).toLocaleString('es-GT') %></div>
      <div class="label">Total cotizado</div>
    </div>
  </div>
  
  <div class="col-md-6 col-lg-3">
    <div class="stat-card">
      <div class="d-flex justify-content-between align-items-start">
        <div class="icon" style="background: #8b5cf6;">
          <i class="bi bi-receipt"></i>
        </div>
        <span class="badge bg-success-subtle text-success">Pagadas</span>
      </div>
      <div class="value mt-3"><%= facturasTotal %></div>
      <div class="label">Facturas pagadas</div>
    </div>
  </div>
</div>

<div class="row g-4">
  <!-- Servicios por Tipo -->
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-bar-chart me-2"></i>Servicios por Tipo (Este Mes)</span>
      </div>
      <div class="card-body">
        <% if (serviciosPorTipo.length > 0) { %>
          <div class="row g-3">
            <% serviciosPorTipo.forEach((tipo, index) => { 
              const colors = ['#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#ef4444'];
              const color = colors[index % colors.length];
            %>
              <div class="col-md-3 col-6">
                <div class="text-center p-3 rounded" style="background: <%= color %>15;">
                  <div class="mb-2">
                    <div style="height: <%= Math.max(tipo.cantidad * 10, 30) %>px; width: 40px; background: <%= color %>; border-radius: 8px; margin: 0 auto;"></div>
                  </div>
                  <div class="fw-bold" style="color: <%= color %>"><%= tipo.tipo_servicio %></div>
                  <div class="text-muted small"><%= tipo.cantidad %> servicios</div>
                </div>
              </div>
            <% }); %>
          </div>
        <% } else { %>
          <div class="text-center text-muted py-4">
            <i class="bi bi-inbox" style="font-size: 3rem;"></i>
            <p class="mt-2">No hay servicios registrados este mes</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
  
  <!-- Cotizaciones por Estado -->
  <div class="col-lg-4">
    <div class="card">
      <div class="card-header">
        <i class="bi bi-pie-chart me-2"></i>Estado de Cotizaciones
      </div>
      <div class="card-body">
        <% if (cotizacionesPorEstado.length > 0) { %>
          <% cotizacionesPorEstado.forEach(cot => { 
            let badgeClass = 'bg-secondary';
            if (cot.estado_cotizacion === 'Pendiente') badgeClass = 'bg-warning';
            if (cot.estado_cotizacion === 'Aceptada') badgeClass = 'bg-success';
            if (cot.estado_cotizacion === 'Rechazada') badgeClass = 'bg-danger';
          %>
            <div class="d-flex justify-content-between align-items-center mb-3 p-2 rounded" style="background: #f8fafc;">
              <div>
                <span class="badge <%= badgeClass %>"><%= cot.estado_cotizacion %></span>
                <span class="ms-2 text-muted small"><%= cot.cantidad %> cotizaciones</span>
              </div>
              <strong>L.<%= parseFloat(cot.total).toLocaleString('es-GT') %></strong>
            </div>
          <% }); %>
        <% } else { %>
          <div class="text-center text-muted py-4">
            <i class="bi bi-file-earmark-x" style="font-size: 2rem;"></i>
            <p class="mt-2 small">Sin cotizaciones este mes</p>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<!-- Accesos Rápidos -->
<div class="row g-4 mt-2">
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <i class="bi bi-lightning me-2"></i>Accesos Rapidos
      </div>
      <div class="card-body">
        <div class="row g-3">
          <div class="col-md-3 col-6">
            <a href="/admin/empleados/nuevo" class="btn btn-outline-primary w-100 py-3">
              <i class="bi bi-person-plus d-block mb-1" style="font-size: 1.5rem;"></i>
              Nuevo Empleado
            </a>
          </div>
          <div class="col-md-3 col-6">
            <a href="/admin/servicios" class="btn btn-outline-success w-100 py-3">
              <i class="bi bi-briefcase d-block mb-1" style="font-size: 1.5rem;"></i>
              Ver Servicios
            </a>
          </div>
          <div class="col-md-3 col-6">
            <a href="/admin/reportes" class="btn btn-outline-warning w-100 py-3">
              <i class="bi bi-graph-up d-block mb-1" style="font-size: 1.5rem;"></i>
              Generar Reporte
            </a>
          </div>
          <div class="col-md-3 col-6">
            <a href="/admin/auditoria" class="btn btn-outline-secondary w-100 py-3">
              <i class="bi bi-shield-check d-block mb-1" style="font-size: 1.5rem;"></i>
              Ver Auditoria
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/admin-footer') %>
