<%- include('../../partials/admin-header', { active: 'expedientes' }) %>

<!-- Tom Select CDN -->
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="page-title">Nuevo Expediente</h1>
    <p class="page-subtitle mb-0">Crea un expediente para agrupar servicios de un candidato</p>
  </div>
  <a href="/admin/expedientes" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left me-2"></i>Volver
  </a>
</div>

<div class="row">
  <div class="col-lg-8">
    <div class="card">
      <div class="card-header">
        <i class="bi bi-folder-plus me-2"></i>Datos del Expediente
      </div>
      <div class="card-body">
        <form action="/admin/expedientes" method="POST">
          <div class="mb-3">
            <label class="form-label">Candidato *</label>
            <select name="id_candidato" id="selectCandidato" class="form-select" required>
              <option value="">Seleccionar candidato...</option>
              <% candidatos.forEach(c => { %>
                <option value="<%= c.id_candidato %>">
                  <%= c.p_apellido %> <%= c.s_apellido || '' %>, <%= c.p_nombre %> <%= c.s_nombre || '' %> — <%= c.dni %>
                </option>
              <% }); %>
            </select>
            <small class="text-muted">Si el candidato no existe, debe registrarlo primero desde el panel de digitador</small>
          </div>
          
          <div class="mb-3">
            <label class="form-label">Empresa Cliente *</label>
            <select name="id_empresa" id="selectEmpresa" class="form-select" required>
              <option value="">Seleccionar empresa...</option>
              <% empresas.forEach(emp => { %>
                <option value="<%= emp.id_empresa %>"><%= emp.empresa %></option>
              <% }); %>
            </select>
          </div>
          
          <div class="mb-3">
            <label class="form-label">Observaciones</label>
            <textarea name="observaciones" class="form-control" rows="3" placeholder="Notas adicionales sobre el expediente..."></textarea>
          </div>
          
          <div class="d-flex justify-content-end">
            <a href="/admin/expedientes" class="btn btn-outline-secondary me-2">Cancelar</a>
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-check-lg me-2"></i>Crear Expediente
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
  
  <div class="col-lg-4">
    <div class="card bg-light border-0">
      <div class="card-body">
        <h5 class="card-title"><i class="bi bi-info-circle me-2"></i>Información</h5>
        <p class="card-text small text-muted">
          Un expediente agrupa varios servicios de un mismo candidato para una empresa.
        </p>
        <ul class="small text-muted ps-3">
          <li>Primero crea el expediente</li>
          <li>Luego agrega los servicios desde el detalle</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  new TomSelect('#selectCandidato', {
    placeholder: 'Buscar candidato por nombre o DNI...',
    allowEmptyOption: false
  });
  
  new TomSelect('#selectEmpresa', {
    placeholder: 'Buscar empresa...',
    allowEmptyOption: false
  });
});
</script>

<%- include('../../partials/admin-footer') %>
