<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Informe Expediente #<%= expediente.id_expediente %> - SECU</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">
  <style>
    @media print {
      .no-print { display: none !important; }
      [data-print-show] { display: block !important; }
      body { font-size: 12pt; }
      .page-break { page-break-before: always; }
      .card { border: 1px solid #dee2e6 !important; box-shadow: none !important; }
    }
    
    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background: #fff;
      color: #1e293b;
    }
    
    .header-brand {
      background: linear-gradient(135deg, #0e7490 0%, #0891b2 100%);
      color: white;
      padding: 30px;
      margin-bottom: 30px;
    }
    
    .section-title {
      background: #f1f5f9;
      padding: 10px 15px;
      margin: 20px 0 15px 0;
      border-left: 4px solid #0e7490;
      font-weight: 600;
    }
    
    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 15px;
    }
    
    .info-item {
      padding: 10px;
      background: #f8fafc;
      border-radius: 8px;
    }
    
    .info-label {
      font-size: 0.8rem;
      color: #64748b;
      text-transform: uppercase;
      margin-bottom: 5px;
    }
    
    .info-value {
      font-weight: 600;
      color: #1e293b;
    }
    
    .service-card {
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      margin-bottom: 20px;
      overflow: hidden;
    }
    
    .service-header {
      background: #f8fafc;
      padding: 15px;
      border-bottom: 1px solid #e2e8f0;
    }
    
    .service-body {
      padding: 20px;
    }
    
    .badge-resultado {
      padding: 8px 15px;
      border-radius: 20px;
      font-weight: 600;
    }
    
    .badge-verdad { background: #dcfce7; color: #166534; }
    .badge-engano { background: #fef2f2; color: #991b1b; }
    .badge-inconcluso { background: #fef9c3; color: #854d0e; }
  </style>
</head>
<body>
  <!-- Botones de accion -->
  <div class="container-fluid no-print py-3 bg-light border-bottom">
    <div class="d-flex justify-content-between align-items-center">
      <a href="/admin/expedientes/<%= expediente.id_expediente %>" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-2"></i>Volver al expediente
      </a>
      <button onclick="window.print()" class="btn btn-primary">
        <i class="bi bi-printer me-2"></i>Imprimir / Exportar PDF
      </button>
    </div>
  </div>
  
  <!-- Encabezado del informe -->
  <div class="header-brand">
    <div class="container">
      <div class="row align-items-center">
        <div class="col-md-6">
          <h1 class="mb-1">SECU</h1>
          <p class="mb-0 opacity-75">Sistema de Evaluacion y Control de Personal</p>
        </div>
        <div class="col-md-6 text-md-end">
          <h4 class="mb-1">INFORME DE EXPEDIENTE</h4>
          <p class="mb-0">Expediente #<%= expediente.id_expediente %></p>
          <p class="mb-0 small opacity-75">Generado: <%= fechaGeneracion.toLocaleDateString('es-HN') %> <%= fechaGeneracion.toLocaleTimeString('es-HN') %></p>
        </div>
      </div>
    </div>
  </div>
  
  <div class="container">
    <!-- Empresa cliente -->
    <div class="alert alert-info d-flex align-items-center mb-4">
      <i class="bi bi-building me-3" style="font-size: 1.5rem;"></i>
      <div>
        <strong>Empresa Cliente:</strong> <%= expediente.empresa %><br>
        <small>Estado del expediente: <strong><%= expediente.estado %></strong></small>
      </div>
    </div>
    
    <!-- Datos del Candidato -->
    <div class="section-title">
      <i class="bi bi-person me-2"></i>DATOS DEL CANDIDATO
    </div>
    <div class="info-grid mb-4">
      <div class="info-item">
        <div class="info-label">Nombre Completo</div>
        <div class="info-value"><%= expediente.p_nombre %> <%= expediente.s_nombre || '' %> <%= expediente.p_apellido %> <%= expediente.s_apellido || '' %></div>
      </div>
      <div class="info-item">
        <div class="info-label">DNI</div>
        <div class="info-value"><%= expediente.dni %></div>
      </div>
      <div class="info-item">
        <div class="info-label">Correo</div>
        <div class="info-value"><%= expediente.correo %></div>
      </div>
      <div class="info-item">
        <div class="info-label">Telefono</div>
        <div class="info-value"><%= expediente.telefono %></div>
      </div>
      <div class="info-item">
        <div class="info-label">Genero</div>
        <div class="info-value"><%= expediente.genero || 'No especificado' %></div>
      </div>
      <div class="info-item">
        <div class="info-label">Fecha de Nacimiento</div>
        <div class="info-value"><%= expediente.fecha_nacimiento ? new Date(expediente.fecha_nacimiento).toLocaleDateString('es-HN') : 'N/A' %></div>
      </div>
    </div>
    
    <!-- Servicios -->
    <div class="section-title">
      <i class="bi bi-briefcase me-2"></i>SERVICIOS REALIZADOS (<%= servicios.length %>)
    </div>
    
    <% servicios.forEach((servicio, index) => { %>
      <div class="service-card">
        <div class="service-header d-flex justify-content-between align-items-center">
          <div>
            <h5 class="mb-0"><%= servicio.tipo_servicio %></h5>
            <small class="text-muted">Encuestador: <%= servicio.encuestador_nombre %> | Fecha: <%= new Date(servicio.fecha_servicio).toLocaleDateString('es-HN') %></small>
          </div>
          <span class="badge bg-<%= servicio.estado_servicio === 'Finalizado' ? 'success' : 'warning' %>">
            <%= servicio.estado_servicio %>
          </span>
        </div>
        <div class="service-body">
          <% if (servicio.socioeconomico) { %>
            <div class="mb-4">
              <h6 class="text-primary"><i class="bi bi-house me-2"></i>Estudio Socioeconomico</h6>
              <div class="row g-3">
                <div class="col-md-4">
                  <small class="text-muted">Tipo de Vivienda</small>
                  <p class="mb-0"><strong><%= servicio.socioeconomico.tipo_vivienda || 'N/A' %></strong></p>
                </div>
                <div class="col-md-4">
                  <small class="text-muted">Trabaja Actualmente</small>
                  <p class="mb-0"><strong><%= servicio.socioeconomico.trabaja_actualmente ? 'Si' : 'No' %></strong></p>
                </div>
                <div class="col-md-4">
                  <small class="text-muted">Empresa Actual</small>
                  <p class="mb-0"><strong><%= servicio.socioeconomico.empresa_actual || 'N/A' %></strong></p>
                </div>
                <div class="col-md-3">
                  <small class="text-muted">Ingreso Personal</small>
                  <p class="mb-0"><strong>L. <%= parseFloat(servicio.socioeconomico.ingreso_mensual_personal || 0).toFixed(2) %></strong></p>
                </div>
                <div class="col-md-3">
                  <small class="text-muted">Ingreso Hogar</small>
                  <p class="mb-0"><strong>L. <%= parseFloat(servicio.socioeconomico.ingreso_mensual_hogar || 0).toFixed(2) %></strong></p>
                </div>
                <div class="col-md-3">
                  <small class="text-muted">Estado Civil</small>
                  <p class="mb-0"><strong><%= servicio.socioeconomico.estado_civil || 'N/A' %></strong></p>
                </div>
                <div class="col-md-3">
                  <small class="text-muted">Personas en Casa</small>
                  <p class="mb-0"><strong><%= servicio.socioeconomico.personas_en_casa %></strong></p>
                </div>
              </div>
              <% if (servicio.socioeconomico.comentarios) { %>
                <div class="mt-3 p-2 bg-light rounded">
                  <small class="text-muted">Comentarios:</small>
                  <p class="mb-0 small"><%= servicio.socioeconomico.comentarios %></p>
                </div>
              <% } %>
            </div>
          <% } %>
          
          <% if (servicio.poligrafia) { %>
            <div class="mb-4">
              <h6 class="text-primary"><i class="bi bi-activity me-2"></i>Evaluacion Poligrafica</h6>
              <div class="row align-items-center g-3">
                <div class="col-md-4">
                  <small class="text-muted">Resultado</small>
                  <p class="mb-0">
                    <% 
                      let resClass = 'badge-inconcluso';
                      if (servicio.poligrafia.resultado === 'Verdad') resClass = 'badge-verdad';
                      if (servicio.poligrafia.resultado === 'Engano') resClass = 'badge-engano';
                    %>
                    <span class="badge-resultado <%= resClass %>"><%= servicio.poligrafia.resultado %></span>
                  </p>
                </div>
                <div class="col-md-4">
                  <small class="text-muted">Nivel de Veracidad</small>
                  <div class="progress" style="height: 20px;">
                    <div class="progress-bar bg-<%= servicio.poligrafia.nivel_veracidad_general >= 7 ? 'success' : servicio.poligrafia.nivel_veracidad_general >= 4 ? 'warning' : 'danger' %>" 
                         style="width: <%= servicio.poligrafia.nivel_veracidad_general * 10 %>%">
                      <%= servicio.poligrafia.nivel_veracidad_general %>/10
                    </div>
                  </div>
                </div>
                <div class="col-md-4">
                  <small class="text-muted">Firmado</small>
                  <p class="mb-0"><strong><%= servicio.poligrafia.firma_evaluador ? 'Si' : 'No' %></strong></p>
                </div>
              </div>
              <% if (servicio.poligrafia.comentarios) { %>
                <div class="mt-3 p-2 bg-light rounded">
                  <small class="text-muted">Comentarios del evaluador:</small>
                  <p class="mb-0 small"><%= servicio.poligrafia.comentarios %></p>
                </div>
              <% } %>
            </div>
          <% } %>
          
          <% if (servicio.psicometrico) { %>
            <div class="mb-4">
              <h6 class="text-primary"><i class="bi bi-graph-up me-2"></i>Evaluacion Psicometrica</h6>
              <div class="row g-3">
                <div class="col-md-6">
                  <small class="text-muted">Estado</small>
                  <p class="mb-0"><strong><%= servicio.psicometrico.estado_formulario %></strong></p>
                </div>
                <div class="col-md-6">
                  <small class="text-muted">Reporte PDF</small>
                  <p class="mb-0">
                    <% if (servicio.psicometrico.url_reporte_pdf) { %>
                      <a href="<%= servicio.psicometrico.url_reporte_pdf %>" target="_blank" class="btn btn-sm btn-outline-primary no-print">
                        <i class="bi bi-file-pdf me-1"></i>Ver PDF
                      </a>
                      <span class="d-none d-print-block" data-print-show>
                        <small class="text-muted">
                          Reporte PDF disponible en:<br>
                          <span style="font-size:0.7rem; word-break:break-all;">
                            <%= servicio.psicometrico.url_reporte_pdf %>
                          </span>
                        </small>
                      </span>
                    <% } else { %>
                      <span class="text-muted">No adjuntado</span>
                    <% } %>
                  </p>
                </div>
              </div>
              <% if (servicio.psicometrico.comentarios) { %>
                <div class="mt-3 p-2 bg-light rounded">
                  <small class="text-muted">Comentarios:</small>
                  <p class="mb-0 small"><%= servicio.psicometrico.comentarios %></p>
                </div>
              <% } %>
            </div>
          <% } %>
          
          <% if (servicio.documentosSocioeconomico && servicio.documentosSocioeconomico.length > 0) { %>
            <div>
              <h6 class="text-primary"><i class="bi bi-paperclip me-2"></i>Documentos Adjuntos (<%= servicio.documentosSocioeconomico.length %>)</h6>
              <ul class="list-group list-group-flush">
                <% servicio.documentosSocioeconomico.forEach(doc => {
                   const esImagen = /\.(jpg|jpeg|png|webp|gif)$/i.test(doc.nombre_archivo || "");
                %>
                  <li class="list-group-item">
                    <div><strong><%= doc.tipo_documento %></strong>: <%= doc.nombre_archivo %></div>
                    <% if (esImagen) { %>
                      <img src="<%= doc.url_documento %>"
                           style="max-width:100%; max-height:200px; object-fit:contain; margin-top:8px;"
                           alt="<%= doc.tipo_documento %>">
                    <% } %>
                    <a href="<%= doc.url_documento %>" target="_blank" class="btn btn-sm btn-outline-secondary mt-1 no-print">
                      <i class="bi bi-download"></i> Descargar
                    </a>
                  </li>
                <% }); %>
              </ul>
            </div>
          <% } %>
          
          <% if (!servicio.socioeconomico && !servicio.poligrafia && !servicio.psicometrico) { %>
            <p class="text-muted mb-0"><i class="bi bi-info-circle me-2"></i>No hay formularios completados para este servicio.</p>
          <% } %>
        </div>
      </div>
    <% }); %>
    
    <% if (servicios.length === 0) { %>
      <div class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>No hay servicios registrados en este expediente.
      </div>
    <% } %>
    
    <!-- Pie de pagina -->
    <div class="mt-5 pt-4 border-top text-center text-muted small">
      <p class="mb-0">SECU - Sistema de Evaluacion y Control de Personal</p>
      <p class="mb-0">Documento generado automaticamente. <%= fechaGeneracion.toLocaleString('es-HN') %></p>
    </div>
  </div>
  
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
