<%- include('../../partials/admin-header', { active: 'cotizaciones' }) %>

<!-- Tom Select CDN -->
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="page-title">Gestión de Cotizaciones</h1>
    <p class="page-subtitle mb-0">Visualiza y gestiona las cotizaciones del sistema</p>
  </div>
  <a href="/admin/cotizaciones/nuevo" class="btn btn-primary">
    <i class="bi bi-plus-lg me-2"></i>Nueva Cotizacion
  </a>
</div>

<!-- Filtros -->
<div class="card mb-4">
  <div class="card-body">
    <form action="/admin/cotizaciones" method="GET" class="row g-3 align-items-end">
      
      <div class="col">
        <div class="input-group">
          <span class="input-group-text"><i class="bi bi-search"></i></span>
          <input type="text" class="form-control" name="buscar" placeholder="Buscar por código o empresa..." value="<%= filtros.buscar || '' %>">
        </div>
      </div>

      <div class="col-md-3">
        <select class="form-select" name="empresa" id="filtroEmpresaAdminCot">
          <option value="">Todas las empresas</option>
          <% if (typeof empresas !== 'undefined') { %>
            <% empresas.forEach(emp => { %>
              <option value="<%= emp.id_empresa %>" <%= filtros.empresa == emp.id_empresa ? 'selected' : '' %>><%= emp.empresa %></option>
            <% }); %>
          <% } %>
        </select>
      </div>

      <div class="col-md-2">
        <select class="form-select" name="estado">
          <option value="">Todos los estados</option>
          <option value="Pendiente" <%= filtros.estado === 'Pendiente' ? 'selected' : '' %>>Pendiente</option>
          <option value="Aceptada" <%= filtros.estado === 'Aceptada' ? 'selected' : '' %>>Aceptada</option>
          <option value="Rechazada" <%= filtros.estado === 'Rechazada' ? 'selected' : '' %>>Rechazada</option>
        </select>
      </div>

      <div class="col-auto d-flex gap-2">
        
        <button type="submit" class="btn btn-primary d-flex align-items-center justify-content-center" 
                style="min-width: 160px; height: 38px;">
          <i class="bi bi-search me-2"></i> Filtrar
        </button>

        <a href="/admin/cotizaciones" 
           class="btn btn-outline-secondary d-flex align-items-center justify-content-center" 
           style="width: 38px; height: 38px; min-width: 38px; padding: 0;" 
           title="Limpiar filtros">
          <i class="bi bi-x-lg"></i>
        </a>
      </div>

    </form>
  </div>
</div>

<!-- Tabla de Cotizaciones -->
<div class="card">
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0">
        <thead>
          <tr>
            <th style="width:12%">Codigo</th>
            <th style="width:20%">Empresa</th>
            <th style="width:10%">Fecha</th>
            <th style="width:12%">Subtotal</th>
            <th style="width:10%">IVA (15%)</th>
            <th style="width:12%">Total</th>
            <th style="width:10%">Estado</th>
            <th style="width:14%" class="text-center">Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% if (cotizaciones.length > 0) { %>
            <% cotizaciones.forEach(cot => { 
              let badgeClass = 'bg-secondary';
              if (cot.estado_cotizacion === 'Pendiente') badgeClass = 'bg-warning';
              if (cot.estado_cotizacion === 'Aceptada') badgeClass = 'bg-success';
              if (cot.estado_cotizacion === 'Rechazada') badgeClass = 'bg-danger';
            %>
              <tr>
                <td><strong><%= cot.codigo_cotizacion %></strong></td>
                <td><%= cot.empresa %></td>
                <td><%= new Date(cot.fecha_cotizacion).toLocaleDateString('es-GT') %></td>
                <td>L. <%= parseFloat(cot.subtotal).toLocaleString('es-GT', {minimumFractionDigits: 2}) %></td>
                <td>L. <%= parseFloat(cot.impuesto_iva).toLocaleString('es-GT', {minimumFractionDigits: 2}) %></td>
                <td><strong>L. <%= parseFloat(cot.total_cotizado).toLocaleString('es-GT', {minimumFractionDigits: 2}) %></strong></td>
                <td><span class="badge <%= badgeClass %>"><%= cot.estado_cotizacion %></span></td>
                <td class="text-center">
                  <a href="/admin/cotizaciones/<%= cot.id_cotizacion %>" class="btn btn-sm btn-primary me-1">
                    <i class="bi bi-eye me-1"></i>Ver
                  </a>
                  <% if (cot.estado_cotizacion === 'Pendiente') { %>
                    <button type="button" class="btn btn-sm btn-outline-danger"
                      title="Eliminar cotizacion"
                      onclick="confirmarAccion(
                        'Eliminar Cotizacion',
                        'Se eliminara la cotizacion <%= cot.codigo_cotizacion %>. Solo es posible si no tiene facturas relacionadas.',
                        '/admin/cotizaciones/<%= cot.id_cotizacion %>/eliminar'
                      )">
                      <i class="bi bi-trash"></i>
                    </button>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="8" class="text-center py-5">
                <i class="bi bi-file-earmark-text" style="font-size: 3rem; color: #94a3b8;"></i>
                <p class="text-muted mt-2">No se encontraron cotizaciones</p>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
<% if (totalPages > 1) { %>
<nav class="mt-3 px-3 pb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
  <small class="text-muted">Mostrando <%= (page-1)*10+1 %>–<%= Math.min(page*10, total) %> de <%= total %> registros</small>
  <ul class="pagination pagination-sm mb-0">
    <li class="page-item <%= page <= 1 ? 'disabled' : '' %>">
      <a class="page-link" href="?<%= new URLSearchParams({...filtros, page: page-1}).toString() %>"><i class="bi bi-chevron-left"></i></a>
    </li>
    <% for(let i = 1; i <= totalPages; i++) { %>
      <% if (i === 1 || i === totalPages || (i >= page-2 && i <= page+2)) { %>
        <li class="page-item <%= i === page ? 'active' : '' %>">
          <a class="page-link" href="?<%= new URLSearchParams({...filtros, page: i}).toString() %>"><%= i %></a>
        </li>
      <% } else if (i === page-3 || i === page+3) { %>
        <li class="page-item disabled"><span class="page-link">…</span></li>
      <% } %>
    <% } %>
    <li class="page-item <%= page >= totalPages ? 'disabled' : '' %>">
      <a class="page-link" href="?<%= new URLSearchParams({...filtros, page: page+1}).toString() %>"><i class="bi bi-chevron-right"></i></a>
    </li>
  </ul>
</nav>
<% } %>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  new TomSelect('#filtroEmpresaAdminCot', {
    placeholder: 'Buscar empresa...',
    allowEmptyOption: true
  });
});
</script>

<%- include('../../partials/admin-footer') %>
