<%- include('../../partials/admin-header', { active: 'tipos-servicio' }) %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1 class="page-title">Tipos de Servicio</h1>
    <p class="page-subtitle mb-0">Administra los tipos de servicio y sus precios</p>
  </div>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#nuevoTipoModal">
    <i class="bi bi-plus-lg me-2"></i>Nuevo Tipo
  </button>
</div>

<!-- Lista de Tipos -->
<div class="row g-4">
  <% if (tipos.length > 0) { %>
    <% tipos.forEach((tipo, index) => { 
      const colors = ['#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#ef4444'];
      const color = colors[index % colors.length];
    %>
      <div class="col-md-6 col-lg-4">
        <div class="card h-100">
          <div class="card-body">
            <div class="d-flex align-items-start mb-3">
              <div class="me-3" style="width: 50px; height: 50px; background: <%= color %>20; border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                <i class="bi bi-tag-fill" style="color: <%= color %>; font-size: 1.3rem;"></i>
              </div>
              <div class="flex-grow-1">
                <h5 class="card-title mb-1"><%= tipo.tipo_servicio %></h5>
                <span class="badge" style="background: <%= color %>20; color: <%= color %>;">ID: <%= tipo.id_tipo_servicio %></span>
              </div>
            </div>
            <div class="p-3 rounded" style="background: #f8fafc;">
              <small class="text-muted">Precio Actual</small>
              <h3 class="mb-0" style="color: <%= color %>;">L. <%= parseFloat(tipo.precio_actual).toFixed(2) %></h3>
            </div>
          </div>
          <div class="card-footer bg-transparent border-top-0 d-flex justify-content-between">
            <button class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editarModal<%= tipo.id_tipo_servicio %>">
              <i class="bi bi-pencil me-1"></i>Editar
            </button>
            <button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#eliminarModal<%= tipo.id_tipo_servicio %>">
              <i class="bi bi-trash"></i>
            </button>
          </div>
          
          <!-- Modal Eliminar -->
          <div class="modal fade" id="eliminarModal<%= tipo.id_tipo_servicio %>" tabindex="-1">
            <div class="modal-dialog">
              <div class="modal-content">
                <form action="/admin/tipos-servicio/eliminar/<%= tipo.id_tipo_servicio %>" method="POST">
                  <div class="modal-header bg-danger text-white">
                    <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Eliminar Tipo de Servicio</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                  </div>
                  <div class="modal-body">
                    <p>Esta seguro que desea eliminar el tipo de servicio <strong><%= tipo.tipo_servicio %></strong>?</p>
                    <div class="alert alert-warning">
                      <i class="bi bi-info-circle me-2"></i>No se podra eliminar si hay servicios asociados a este tipo.
                    </div>
                  </div>
                  <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Eliminar</button>
                  </div>
                </form>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Modal Editar -->
        <div class="modal fade" id="editarModal<%= tipo.id_tipo_servicio %>" tabindex="-1">
          <div class="modal-dialog">
            <div class="modal-content">
              <form action="/admin/tipos-servicio/editar/<%= tipo.id_tipo_servicio %>" method="POST">
                <div class="modal-header">
                  <h5 class="modal-title">Editar Tipo de Servicio</h5>
                  <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                  <div class="mb-3">
                    <label class="form-label">Nombre del Servicio *</label>
                    <input type="text" class="form-control" name="tipo_servicio" value="<%= tipo.tipo_servicio %>" required>
                  </div>
                  <div class="mb-3">
                    <label class="form-label">Precio Actual (L.) *</label>
                    <input type="number" step="0.01" class="form-control" name="precio_actual" value="<%= tipo.precio_actual %>" required>
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                  <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
  <% } else { %>
    <div class="col-12">
      <div class="card">
        <div class="card-body text-center py-5">
          <i class="bi bi-tags" style="font-size: 4rem; color: #94a3b8;"></i>
          <h4 class="mt-3 text-muted">No hay tipos de servicio</h4>
          <p class="text-muted">Comience agregando un nuevo tipo</p>
        </div>
      </div>
    </div>
  <% } %>
</div>

<!-- Modal Nuevo Tipo -->
<div class="modal fade" id="nuevoTipoModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/admin/tipos-servicio" method="POST">
        <div class="modal-header">
          <h5 class="modal-title">Nuevo Tipo de Servicio</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Nombre del Servicio *</label>
            <input type="text" class="form-control" name="tipo_servicio" placeholder="Ej: Poligrafia, Estudio Socioeconomico..." required>
          </div>
          <div class="mb-3">
            <label class="form-label">Precio Actual (L.) *</label>
            <input type="number" step="0.01" class="form-control" name="precio_actual" placeholder="0.00" required>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
          <button type="submit" class="btn btn-primary">Guardar</button>
        </div>
      </form>
    </div>
  </div>
</div>

<%- include('../../partials/admin-footer') %>
